// @Plew/Syntax — the syntax library for user-defined metaprogramming (spec/16).
//
// A macro is a struct implementing `Derive`: it receives the annotated item's
// syntax tree (`DeclAst`) and returns generated Plew source (`String`). The
// `plew gen` runner synthesizes a harness that calls the provided method
// `deriveFromSource` (which lexes+parses the item's source text into a `DeclAst`
// and delegates to the user's `derive`), so the runner stays a version-agnostic
// String↔String machine that never touches the AST types.
//
// M1: the syntactic layer lives here as the one shared core. The AST value types
// (`Kind`/`Tok`/`DeclAst`/… and the parser free functions `lex`/`parseProgramAst`/
// `parseItem`) live at this module root; the parts hold only `impl` blocks (spec/15
// part=impl-only): the lexer's (`part ./Lexer`, shared with the compiler
// frontend), the parser's (`part ./Parser`), and the builder's
// (`part ./Build`). An item's source slice lexes + parses into a `DeclAst`.

// `stringFromBytesUnchecked` (build a String from a byte slice) is used by the parser to
// turn token byte-ranges into name Strings.
import @Std/Core with { Eq, stringFromBytesUnchecked }
export @Std/Core with { Eq }

part ./Lexer
part ./Parser
part ./Build
part ./Arena

// A derive is anything that implements a derive interface; `@[X]` is valid when X
// does (spec/16). The single axis is whether the derive carries configuration:
//
// - no config → `Derive` (an `assoc fn derive`, no `self`): invoked bare `@[X]`.
//   A trait can implement it (`impl Hash as Derive` — the deriver lives here in
//   Derive's module, coherent, referencing the ambient `Hash`), as can a no-field
//   struct (`impl Show as Derive`). The annotated item arrives as `TopItemAst`
//   (the deriver `match`es its kind: `Decl` for struct/enum/fn, `Impl`, `Trait`).
// - config → `ParameterizedDerive` (an instance `fn derive`, `self` = the config
//   struct built from the directive args): invoked `@[X(args)]`.
//
// The `plew gen` runner synthesizes a harness that calls `X.derive(input:
// parseItem(...))` (bare) or `<X args/>.derive(input: parseItem(...))` (config) and
// writes the returned String — so the runner stays a version-agnostic String↔String
// machine. (`parseItem` turns the item's source slice into the `TopItemAst`.)
export trait Derive {
    assoc fn derive(input: TopItemAst) -> String
}
export trait ParameterizedDerive {
    fn derive(input: TopItemAst) -> String
}

// Built-in `@[Hash]` derive, dogfooded as a real `Derive` (spec/16). It lives here
// — in `Derive`'s own module — so conforming the ambient `Hash` trait (Prelude) to
// `Derive` is coherent (no orphan, no colliding `struct Hash`). It loads only when
// @Plew/Syntax loads (gen mode + the compiler's own build, where it is dead code);
// normal builds read the committed `.gen.pw`. Generates a field-wise
// `pub impl T as Hash { fn hash[H](hasher: inout H) ... }` for a struct, hashing
// each field via its own `Hash`. (Enum payloads are a follow-up.)
pub impl Hash as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                s.put("pub impl ")
                s.put(d.name)
                s.put(" as Hash {\n    fn hash[H](hasher: inout H) where H: Hasher {\n")
                mut val i: U64 = 0
                while i < d.fields.count() {
                    s.put("        self.")
                    s.put(d.fields[i].name)
                    s.put(".hash(hasher: inout hasher)\n")
                    i += 1
                }
                s.put("    }\n}\n")
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

// Built-in `@[Eq]` derive (spec/16) as a real `impl Eq as Derive` — no compiler-
// privileged synthesis. Generates `pub impl <T> as Eq { assoc fn eq(...) -> Bool }`:
// a struct compares field-wise (`lhs.f == rhs.f && ...`, `true` when field-less); an
// enum matches both operands (tags must agree, then payloads compare field-wise, else
// `false`). Each field/payload `==` recurses into that type's own Eq. Generic types get
// `impl[T] N[T] as Eq where T: Eq`. Auto-parted into the annotated type's module, so it
// reads private fields.
pub impl Eq as Derive {
    assoc fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                match d.kind {
                    DeclKind.Struct => { return deriveEqStruct(d: d) }
                    DeclKind.Enum => { return deriveEqEnum(d: d) }
                    DeclKind.Func => { return "" }
                }
            }
            _ => { return "" }
        }
    }
}

// `pub impl[<tps>] <Name>[<tps>] as <trait> where <tp>: <bound>, ... {\n` — or the
// non-generic `pub impl <Name> as <trait> {\n` when there are no type parameters.
fn putDeriveHeader(s: inout Src, d: DeclAst, traitName: String, bound: String) {
    s.put("pub impl")
    val n: U64 = d.typeParams.count()
    if n > 0 {
        s.put("[")
        putCommaList(s: inout s, xs: d.typeParams)
        s.put("] ")
        s.put(d.name)
        s.put("[")
        putCommaList(s: inout s, xs: d.typeParams)
        s.put("]")
    } else {
        s.put(" ")
        s.put(d.name)
    }
    s.put(" as ")
    s.put(traitName)
    if n > 0 {
        s.put(" where ")
        mut val i: U64 = 0
        while i < n {
            if i > 0 { s.put(", ") }
            s.put(d.typeParams[i])
            s.put(": ")
            s.put(bound)
            i += 1
        }
    }
    s.put(" {\n")
}

fn putCommaList(s: inout Src, xs: Array[String]) {
    mut val i: U64 = 0
    while i < xs.count() {
        if i > 0 { s.put(", ") }
        s.put(xs[i])
        i += 1
    }
}

// The concrete self-type spelling used for parameter types: `<Name>` or `<Name>[T, U]`.
fn putSelfType(s: inout Src, d: DeclAst) {
    s.put(d.name)
    if d.typeParams.count() > 0 {
        s.put("[")
        putCommaList(s: inout s, xs: d.typeParams)
        s.put("]")
    }
}

// `    assoc fn eq(lhs~: <Self>, rhs~: <Self>) -> Bool {\n` — the shared witness signature.
fn putEqSignature(s: inout Src, d: DeclAst) {
    s.put("    assoc fn eq(lhs~: ")
    putSelfType(s: inout s, d: d)
    s.put(", rhs~: ")
    putSelfType(s: inout s, d: d)
    s.put(") -> Bool {\n")
}

fn deriveEqStruct(d: DeclAst) -> String {
    mut val s: Src = newSrc()
    putDeriveHeader(s: inout s, d: d, traitName: "Eq", bound: "Eq")
    putEqSignature(s: inout s, d: d)
    s.put("        return ")
    if d.fields.count() == 0 {
        s.put("true")
    } else {
        mut val i: U64 = 0
        while i < d.fields.count() {
            if i > 0 { s.put(" && ") }
            s.put("lhs.")
            s.put(d.fields[i].name)
            s.put(" == rhs.")
            s.put(d.fields[i].name)
            i += 1
        }
    }
    s.put("\n    }\n}\n")
    return s.finish()
}

fn deriveEqEnum(d: DeclAst) -> String {
    mut val s: Src = newSrc()
    putDeriveHeader(s: inout s, d: d, traitName: "Eq", bound: "Eq")
    putEqSignature(s: inout s, d: d)
    s.put("        match lhs {\n")
    mut val vi: U64 = 0
    while vi < d.variants.count() {
        val v: VariantAst = d.variants[vi]
        s.put("            ")
        s.put(d.name)
        s.put(".")
        s.put(v.name)
        putVariantBinds(s: inout s, v: v, prefix: "l_")
        s.put(" => {\n                match rhs {\n                    ")
        s.put(d.name)
        s.put(".")
        s.put(v.name)
        putVariantBinds(s: inout s, v: v, prefix: "r_")
        s.put(" => {\n                        return ")
        if v.fields.count() == 0 {
            s.put("true")
        } else {
            mut val fi: U64 = 0
            while fi < v.fields.count() {
                if fi > 0 { s.put(" && ") }
                s.put("l_")
                s.put(v.fields[fi].name)
                s.put(" == r_")
                s.put(v.fields[fi].name)
                fi += 1
            }
        }
        s.put("\n                    }\n")
        // the catch-all is only reachable (and thus only legal) when there is more
        // than one variant; a single-variant enum's inner match is already exhaustive.
        if d.variants.count() > 1 {
            s.put("                    _ => { return false }\n")
        }
        s.put("                }\n            }\n")
        vi += 1
    }
    s.put("        }\n    }\n}\n")
    return s.finish()
}

// `(a: val <prefix>a, b: val <prefix>b)` for a payload variant, or nothing when the
// variant carries no payload.
fn putVariantBinds(s: inout Src, v: VariantAst, prefix: String) {
    if v.fields.count() == 0 { return }
    s.put("(")
    mut val i: U64 = 0
    while i < v.fields.count() {
        if i > 0 { s.put(", ") }
        s.put(v.fields[i].name)
        s.put(": val ")
        s.put(prefix)
        s.put(v.fields[i].name)
        i += 1
    }
    s.put(")")
}

// `@[IntTryFrom(sources: [...])]` — generate primitive integer narrowing TryFrom
// witnesses (spec/12). A pure, branch-free renderer: it knows nothing about which
// (target, source) pairs are fallible — the annotated declaration is the TARGET and
// the directive arg lists the SOURCE types (the fallibility decision lives at the
// declaration site, not here). For each source S it emits the SAME body, delegating
// to the target's own `TryFrom[I64]` witness after a lossless widen `source as I64`
// (every sub-64-bit integer widens losslessly to I64). The per-target range/truncate
// knowledge stays in the hand-written `impl T as TryFrom[I64]` bases in Core — O(8),
// not the O(56) pair matrix. Used by the standalone-equivalent dogfood path: Core
// annotates its primitive decls and commits the generated `Core.gen.pw`.
export struct IntTryFrom {
    pub val sources: Array[String]
}
pub impl IntTryFrom { factory }
pub impl IntTryFrom as ParameterizedDerive {
    fn derive(input: TopItemAst) -> String {
        match input {
            TopItemAst.Decl(val d) => {
                mut val s: Src = newSrc()
                mut val i: U64 = 0
                while i < self.sources.count() {
                    val src: String = self.sources[i]
                    s.put("pub impl ")
                    s.put(d.name)
                    s.put(" as TryFrom[")
                    s.put(src)
                    s.put("] {\n    type Error = RangeError\n    result[RangeError] factory checked(source: ")
                    s.put(src)
                    s.put(") {\n        return <")
                    s.put(d.name)
                    s.put(".checked source=(source as I64) />\n    }\n}\n")
                    i += 1
                }
                return s.finish()
            }
            _ => { return "" }
        }
    }
}

// ---- AST value types + lexer/parser free functions (the module's public surface;
// at the module root so the parts hold only `impl` blocks — spec/15 part=impl-only) ----

@[Eq]
export enum Kind {
    Eof
    Newline
    Int
    Float
    Str
    Char
    Ident
    KwFn
    KwStruct
    KwEnum
    KwMatch
    KwIf
    KwElse
    KwWhile
    KwFor
    KwBreak
    KwContinue
    KwReturn
    KwGive
    KwVal
    KwMut
    KwIn
    KwAs
    KwInout
    KwUnique
    KwSendable
    KwNonsendable
    KwDeinit
    KwMove
    KwBorrow
    KwAsync
    KwSpawn
    KwAwait
    KwExtern
    KwTrue
    KwFalse
    LParen
    RParen
    LBracket
    RBracket
    LBrace
    RBrace
    Comma
    Colon
    Dot
    Eq
    EqEq
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    AmpAmp
    PipePipe
    Bang
    Amp
    Pipe
    Caret
    Shl
    Shr
    Tilde
    Arrow
    FatArrow
    SlashGt
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    AmpEq
    PipeEq
    CaretEq
    ShlEq
    ShrEq
    DotDotLt
    DotDotEq
    OptChain
    Hash
    Unknown
}

export struct Tok {
    pub val kind: Kind
    pub val start: U64
    pub val len: U64
}

export struct Lexer {
    pub val bytes: Array[U8]
    pub mut val pos: U64
    pub mut val toks: Array[Tok]
    pub mut val depth: I64
}

fn isDigit(b: U8) -> Bool {
    if b >= '0' {
        if b <= '9' {
            return true
        }
    }
    return false
}

// A digit of the given base (2 / 8 / 10 / 16) — for lexing `0b` / `0o` / `0x`
// literals (spec/02). Hex accepts a-f / A-F; the lower bases accept their digit range.
fn isBaseDigit(b: U8, base: I64) -> Bool {
    if base == 16 {
        if isDigit(b: b) { return true }
        if b >= 'a' { if b <= 'f' { return true } }
        if b >= 'A' { if b <= 'F' { return true } }
        return false
    }
    if base == 8 {
        if b >= '0' { if b <= '7' { return true } }
        return false
    }
    if base == 2 {
        if b == '0' { return true }
        if b == '1' { return true }
        return false
    }
    return isDigit(b: b)
}

fn isAlpha(b: U8) -> Bool {
    if b == '_' {
        return true
    }
    if b >= 'a' {
        if b <= 'z' {
            return true
        }
    }
    if b >= 'A' {
        if b <= 'Z' {
            return true
        }
    }
    return false
}

fn isAlnum(b: U8) -> Bool {
    if isAlpha(b: b) {
        return true
    }
    return isDigit(b: b)
}

export fn rangeEquals(bytes: Array[U8], start: U64, len: U64, kw: String) -> Bool {
    val kb: Array[U8] = kw.bytes()
    if len != kb.count() {
        return false
    }
    mut val j: U64 = 0
    while j < len {
        if bytes[start + j] != kb[j] {
            return false
        }
        j += 1
    }
    return true
}

fn identKind(bytes: Array[U8], start: U64, len: U64) -> Kind {
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "fn") {
        return <Kind.KwFn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "struct") {
        return <Kind.KwStruct />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "enum") {
        return <Kind.KwEnum />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "match") {
        return <Kind.KwMatch />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "if") {
        return <Kind.KwIf />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "else") {
        return <Kind.KwElse />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "while") {
        return <Kind.KwWhile />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "for") {
        return <Kind.KwFor />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "break") {
        return <Kind.KwBreak />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "continue") {
        return <Kind.KwContinue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "return") {
        return <Kind.KwReturn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "give") {
        return <Kind.KwGive />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "val") {
        return <Kind.KwVal />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "mut") {
        return <Kind.KwMut />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "in") {
        return <Kind.KwIn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "as") {
        return <Kind.KwAs />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "inout") {
        return <Kind.KwInout />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "unique") {
        return <Kind.KwUnique />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "sendable") {
        return <Kind.KwSendable />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "nonsendable") {
        return <Kind.KwNonsendable />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "deinit") {
        return <Kind.KwDeinit />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "move") {
        return <Kind.KwMove />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "borrow") {
        return <Kind.KwBorrow />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "async") {
        return <Kind.KwAsync />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "spawn") {
        return <Kind.KwSpawn />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "await") {
        return <Kind.KwAwait />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "extern") {
        return <Kind.KwExtern />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "true") {
        return <Kind.KwTrue />
    }
    if rangeEquals(bytes: bytes, start: start, len: len, kw: "false") {
        return <Kind.KwFalse />
    }
    return <Kind.Ident />
}

export fn lex(lx: inout Lexer) {
    while lx.pos < lx.bytes.count() {
        val b: U8 = lx.at(off: 0)
        if b == ' ' {
            lx.pos += 1
            continue
        }
        if b == '\t' {
            lx.pos += 1
            continue
        }
        if b == '\r' {
            lx.pos += 1
            continue
        }
        if b == '\n' {
            if lx.depth > 0 {
                lx.pos += 1
            } else {
                if lx.lastCanEnd() {
                    if lx.lastWasNewline() {
                        lx.pos += 1
                    } else {
                        lx.emit(k: <Kind.Newline />, start: lx.pos, len: 1)
                    }
                } else {
                    lx.pos += 1
                }
            }
            continue
        }
        if b == '/' {
            if lx.at(off: 1) == '/' {
                while lx.pos < lx.bytes.count() {
                    if lx.at(off: 0) == '\n' {
                        break
                    }
                    lx.pos += 1
                }
                continue
            }
            // block comment `/* … */`, nestable (`/* a /* b */ c */`).
            if lx.at(off: 1) == '*' {
                lx.pos += 2
                mut val depth: U64 = 1
                while lx.pos < lx.bytes.count() {
                    if depth == 0U64 {
                        break
                    }
                    if lx.at(off: 0) == '/' && lx.at(off: 1) == '*' {
                        depth += 1
                        lx.pos += 2
                    } else {
                        if lx.at(off: 0) == '*' && lx.at(off: 1) == '/' {
                            depth -= 1
                            lx.pos += 2
                        } else {
                            lx.pos += 1
                        }
                    }
                }
                continue
            }
        }
        if isDigit(b: b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            // base-prefixed integer literal: `0x…` (hex) / `0o…` (octal) / `0b…`
            // (binary), with `_` digit separators (spec/02). Always an integer.
            if b == '0' {
                if j + 1U64 < lx.bytes.count() {
                    val p1: U8 = lx.bytes[j + 1U64]
                    mut val base: I64 = 0
                    if p1 == 'x' { base = 16 }
                    if p1 == 'X' { base = 16 }
                    if p1 == 'o' { base = 8 }
                    if p1 == 'O' { base = 8 }
                    if p1 == 'b' { base = 2 }
                    if p1 == 'B' { base = 2 }
                    if base != 0 {
                        j += 2U64
                        while j < lx.bytes.count() {
                            if isBaseDigit(b: lx.bytes[j], base: base) || lx.bytes[j] == '_' {
                                j += 1
                            } else {
                                break
                            }
                        }
                        lx.emit(k: <Kind.Int />, start: start, len: j - start)
                        continue
                    }
                }
            }
            // decimal integer part (allow `_` digit separators)
            while j < lx.bytes.count() {
                if isDigit(b: lx.bytes[j]) || lx.bytes[j] == '_' {
                    j += 1
                } else {
                    break
                }
            }
            mut val isFloat: Bool = false
            if j < lx.bytes.count() {
                if lx.bytes[j] == 46U8 {
                    if j + 1U64 < lx.bytes.count() {
                        if isDigit(b: lx.bytes[j + 1U64]) {
                            isFloat = true
                            j += 1U64
                            while j < lx.bytes.count() {
                                if isDigit(b: lx.bytes[j]) || lx.bytes[j] == '_' {
                                    j += 1
                                } else {
                                    break
                                }
                            }
                        }
                    }
                }
            }
            // optional exponent `[eE][+-]?digits` — makes the number a float even
            // without a fractional part (`1e10`, `2E8`, `1.5e-3`). The `e` is consumed
            // only when (optional sign and) a digit follow.
            if j < lx.bytes.count() {
                if lx.bytes[j] == 101U8 || lx.bytes[j] == 69U8 {
                    mut val k: U64 = j + 1U64
                    if k < lx.bytes.count() {
                        if lx.bytes[k] == 43U8 || lx.bytes[k] == 45U8 {
                            k += 1U64
                        }
                    }
                    if k < lx.bytes.count() {
                        if isDigit(b: lx.bytes[k]) {
                            isFloat = true
                            j = k + 1U64
                            while j < lx.bytes.count() {
                                if isDigit(b: lx.bytes[j]) || lx.bytes[j] == '_' {
                                    j += 1
                                } else {
                                    break
                                }
                            }
                        }
                    }
                }
            }
            if isFloat {
                lx.emit(k: <Kind.Float />, start: start, len: j - start)
            } else {
                lx.emit(k: <Kind.Int />, start: start, len: j - start)
            }
            continue
        }
        if isAlpha(b: b) {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos
            while j < lx.bytes.count() {
                if isAlnum(b: lx.bytes[j]) {
                    j += 1
                } else {
                    break
                }
            }
            val len: U64 = j - start
            val k: Kind = identKind(bytes: lx.bytes, start: start, len: len)
            lx.emit(k: k, start: start, len: len)
            continue
        }
        if b == '"' {
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count() {
                // a backslash escapes the next byte (so `\"` does not close)
                if lx.bytes[j] == '\\' {
                    j += 2
                    continue
                }
                if lx.bytes[j] == '"' {
                    j += 1
                    break
                }
                j += 1
            }
            lx.emit(k: <Kind.Str />, start: start, len: j - start)
            continue
        }
        if b == '\'' {
            // character literal `'…'` (one scalar; backslash escapes the next byte)
            val start: U64 = lx.pos
            mut val j: U64 = lx.pos + 1
            while j < lx.bytes.count() {
                if lx.bytes[j] == '\\' {
                    j += 2
                    continue
                }
                if lx.bytes[j] == '\'' {
                    j += 1
                    break
                }
                j += 1
            }
            lx.emit(k: <Kind.Char />, start: start, len: j - start)
            continue
        }
        val b2: U8 = lx.at(off: 1)
        if b == '.' {
            if b2 == '.' {
                val b3: U8 = lx.at(off: 2)
                if b3 == '<' {
                    lx.emit(k: <Kind.DotDotLt />, start: lx.pos, len: 3)
                    continue
                }
                if b3 == '=' {
                    lx.emit(k: <Kind.DotDotEq />, start: lx.pos, len: 3)
                    continue
                }
            }
            lx.emit(k: <Kind.Dot />, start: lx.pos, len: 1)
            continue
        }
        if b == '=' {
            if b2 == '=' {
                lx.emit(k: <Kind.EqEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.FatArrow />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Eq />, start: lx.pos, len: 1)
            continue
        }
        if b == '!' {
            if b2 == '=' {
                lx.emit(k: <Kind.Ne />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Bang />, start: lx.pos, len: 1)
            continue
        }
        if b == '<' {
            if b2 == '=' {
                lx.emit(k: <Kind.Le />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '<' {
                val b3: U8 = lx.at(off: 2)
                if b3 == '=' {
                    lx.emit(k: <Kind.ShlEq />, start: lx.pos, len: 3)
                    continue
                }
                lx.emit(k: <Kind.Shl />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Lt />, start: lx.pos, len: 1)
            continue
        }
        if b == '>' {
            if b2 == '=' {
                lx.emit(k: <Kind.Ge />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                val b3: U8 = lx.at(off: 2)
                if b3 == '=' {
                    lx.emit(k: <Kind.ShrEq />, start: lx.pos, len: 3)
                    continue
                }
                lx.emit(k: <Kind.Shr />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Gt />, start: lx.pos, len: 1)
            continue
        }
        if b == '+' {
            if b2 == '=' {
                lx.emit(k: <Kind.PlusEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Plus />, start: lx.pos, len: 1)
            continue
        }
        if b == '-' {
            if b2 == '=' {
                lx.emit(k: <Kind.MinusEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.Arrow />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Minus />, start: lx.pos, len: 1)
            continue
        }
        if b == '*' {
            if b2 == '=' {
                lx.emit(k: <Kind.StarEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Star />, start: lx.pos, len: 1)
            continue
        }
        if b == '/' {
            if b2 == '=' {
                lx.emit(k: <Kind.SlashEq />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '>' {
                lx.emit(k: <Kind.SlashGt />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Slash />, start: lx.pos, len: 1)
            continue
        }
        if b == '%' {
            if b2 == '=' {
                lx.emit(k: <Kind.PercentEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Percent />, start: lx.pos, len: 1)
            continue
        }
        if b == '&' {
            if b2 == '&' {
                lx.emit(k: <Kind.AmpAmp />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '=' {
                lx.emit(k: <Kind.AmpEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Amp />, start: lx.pos, len: 1)
            continue
        }
        if b == '|' {
            if b2 == '|' {
                lx.emit(k: <Kind.PipePipe />, start: lx.pos, len: 2)
                continue
            }
            if b2 == '=' {
                lx.emit(k: <Kind.PipeEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Pipe />, start: lx.pos, len: 1)
            continue
        }
        if b == '^' {
            if b2 == '=' {
                lx.emit(k: <Kind.CaretEq />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Caret />, start: lx.pos, len: 1)
            continue
        }
        if b == '~' {
            lx.emit(k: <Kind.Tilde />, start: lx.pos, len: 1)
            continue
        }
        if b == '#' {
            lx.emit(k: <Kind.Hash />, start: lx.pos, len: 1)
            continue
        }
        if b == '?' {
            if b2 == '.' {
                lx.emit(k: <Kind.OptChain />, start: lx.pos, len: 2)
                continue
            }
            lx.emit(k: <Kind.Unknown />, start: lx.pos, len: 1)
            continue
        }
        if b == '(' {
            lx.emit(k: <Kind.LParen />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == ')' {
            lx.emit(k: <Kind.RParen />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == '[' {
            lx.emit(k: <Kind.LBracket />, start: lx.pos, len: 1)
            lx.depth += 1
            continue
        }
        if b == ']' {
            lx.emit(k: <Kind.RBracket />, start: lx.pos, len: 1)
            lx.depth -= 1
            continue
        }
        if b == '{' {
            lx.emit(k: <Kind.LBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == '}' {
            lx.emit(k: <Kind.RBrace />, start: lx.pos, len: 1)
            continue
        }
        if b == ',' {
            lx.emit(k: <Kind.Comma />, start: lx.pos, len: 1)
            continue
        }
        if b == ':' {
            lx.emit(k: <Kind.Colon />, start: lx.pos, len: 1)
            continue
        }
        lx.emit(k: <Kind.Unknown />, start: lx.pos, len: 1)
    }
    lx.toks.append(<Tok kind=<Kind.Eof /> start=lx.pos len=0 />)
}

export fn kindCode(k: Kind) -> I64 {
    return match k {
        Kind.Eof => 0
        Kind.Newline => 1
        Kind.Int => 2
        Kind.Float => 87
        Kind.Str => 3
        Kind.Char => 5
        Kind.Ident => 4
        Kind.KwFn => 10
        Kind.KwStruct => 11
        Kind.KwEnum => 12
        Kind.KwMatch => 13
        Kind.KwIf => 14
        Kind.KwElse => 15
        Kind.KwWhile => 16
        Kind.KwFor => 17
        Kind.KwBreak => 18
        Kind.KwContinue => 19
        Kind.KwReturn => 20
        Kind.KwGive => 21
        Kind.KwVal => 22
        Kind.KwMut => 23
        Kind.KwIn => 24
        Kind.KwAs => 25
        Kind.KwInout => 26
        Kind.KwUnique => 29
        Kind.KwSendable => 36
        Kind.KwNonsendable => 37
        Kind.KwDeinit => 30
        Kind.KwMove => 31
        Kind.KwBorrow => 32
        Kind.KwAsync => 33
        Kind.KwSpawn => 38
        Kind.KwAwait => 34
        Kind.KwExtern => 35
        Kind.KwTrue => 27
        Kind.KwFalse => 28
        Kind.LParen => 40
        Kind.RParen => 41
        Kind.LBracket => 42
        Kind.RBracket => 43
        Kind.LBrace => 44
        Kind.RBrace => 45
        Kind.Comma => 46
        Kind.Colon => 47
        Kind.Dot => 48
        Kind.Eq => 49
        Kind.EqEq => 50
        Kind.Ne => 51
        Kind.Lt => 52
        Kind.Le => 53
        Kind.Gt => 54
        Kind.Ge => 55
        Kind.Plus => 56
        Kind.Minus => 57
        Kind.Star => 58
        Kind.Slash => 59
        Kind.Percent => 60
        Kind.AmpAmp => 61
        Kind.PipePipe => 62
        Kind.Bang => 63
        Kind.Arrow => 64
        Kind.FatArrow => 65
        Kind.SlashGt => 66
        Kind.PlusEq => 67
        Kind.MinusEq => 68
        Kind.StarEq => 69
        Kind.SlashEq => 70
        Kind.PercentEq => 71
        Kind.DotDotLt => 72
        Kind.DotDotEq => 73
        Kind.Amp => 74
        Kind.Pipe => 75
        Kind.Caret => 76
        Kind.Shl => 77
        Kind.Shr => 78
        Kind.Tilde => 79
        Kind.AmpEq => 80
        Kind.PipeEq => 81
        Kind.CaretEq => 82
        Kind.ShlEq => 83
        Kind.ShrEq => 84
        Kind.OptChain => 85
        Kind.Hash => 86
        Kind.Unknown => 99
    }
}

export struct Span {
    pub val start: U64
    pub val end: U64
}

// Compiler-facing syntax arena -------------------------------------------------
//
// The macro-facing value AST below deliberately stays intact: `parseItem` is a
// small, explicit value boundary for Derive.  A normal compiler parse instead
// produces a SyntaxFile whose children are scalar IDs and flat slices.  Keep the
// IDs distinct even though their runtime representation is U64; letting a raw
// index cross from (say) an Expr table into a Type table would make a malformed
// syntax tree look valid to the frontend.
//
// The tables and parser writer are introduced together in subsequent slices.  Do
// not use these types to put TopItemAst behind a Ref or an Array: that would retain
// the value tree and defeat the representation boundary.
export struct SyntaxSlice {
    pub val start: U64
    pub val count: U64
}

export struct TopItemId { pub val raw: U64 }
export struct DeclId { pub val raw: U64 }
export struct ImplId { pub val raw: U64 }
export struct TraitId { pub val raw: U64 }
export struct ExternId { pub val raw: U64 }
export struct ImportId { pub val raw: U64 }
export struct DirectiveId { pub val raw: U64 }
export struct NewtypeId { pub val raw: U64 }
export struct TypeId { pub val raw: U64 }
export struct FieldId { pub val raw: U64 }
export struct VariantId { pub val raw: U64 }
export struct ParamId { pub val raw: U64 }
export struct MemberId { pub val raw: U64 }
export struct SigId { pub val raw: U64 }
export struct StmtId { pub val raw: U64 }
export struct ExprId { pub val raw: U64 }
export struct BlockId { pub val raw: U64 }
export struct PatternId { pub val raw: U64 }
export struct MatchArmId { pub val raw: U64 }
export struct ArgId { pub val raw: U64 }
export struct MakeFieldId { pub val raw: U64 }
export struct BindId { pub val raw: U64 }
export struct DeriveReqId { pub val raw: U64 }

// This tag is intentionally about the top-level syntax category, not a semantic
// declaration kind.  A compiler load pass can decide import/predeclare/lower order
// without materializing a TopItemAst value.
export enum SyntaxTopItemKind {
    Decl
    Impl
    Trait
    Extern
    Import
    Export
    ReExport
    Directive
    GlobalVal
    NewType
}

// A top-level node never contains a value-AST payload. `payload` indexes the
// table selected by `kind` (DeclId, ImplId, TraitId, …); Export uses another
// TopItemId.  Keeping it scalar lets the file's top-level walk remain cheap even
// when one declaration owns a large body.
export struct SyntaxTopItem {
    pub val kind: SyntaxTopItemKind
    pub val payload: U64
    pub val span: Span
}

// The root owner for the compiler-facing immutable representation. Tables are
// added category by category below; all references into them are IDs/slices and
// never nested Ast values. `topLevel` preserves source order, while `topItems`
// is the storage addressed by TopItemId.
export struct SyntaxFile {
    mut val topLevel: Array[TopItemId] = []
    mut val topItems: Array[SyntaxTopItem] = []
    mut val decls: Array[SyntaxDecl] = []
    mut val impls: Array[SyntaxImpl] = []
    mut val traits: Array[SyntaxTrait] = []
    mut val externs: Array[SyntaxExtern] = []
    mut val imports: Array[SyntaxImport] = []
    mut val directives: Array[SyntaxDirective] = []
    mut val newtypes: Array[SyntaxNewtype] = []
    mut val types: Array[SyntaxType] = []
    mut val fields: Array[SyntaxField] = []
    mut val variants: Array[SyntaxVariant] = []
    mut val params: Array[SyntaxParam] = []
    mut val members: Array[SyntaxMember] = []
    mut val sigs: Array[SyntaxSig] = []
    mut val stmts: Array[SyntaxStmt] = []
    mut val exprs: Array[SyntaxExpr] = []
    mut val blocks: Array[SyntaxBlock] = []
    mut val patterns: Array[SyntaxPattern] = []
    mut val matchArms: Array[SyntaxMatchArm] = []
    mut val args: Array[SyntaxArg] = []
    mut val makeFields: Array[SyntaxMakeField] = []
    mut val binds: Array[SyntaxBind] = []
    mut val deriveReqs: Array[SyntaxDeriveReq] = []
    // Flat child pools. A SyntaxSlice always addresses the pool documented by
    // its containing field; tables are never recursively embedded in a node.
    mut val typeIds: Array[TypeId] = []
    mut val fieldIds: Array[FieldId] = []
    mut val variantIds: Array[VariantId] = []
    mut val paramIds: Array[ParamId] = []
    mut val memberIds: Array[MemberId] = []
    mut val sigIds: Array[SigId] = []
    mut val stmtIds: Array[StmtId] = []
    mut val exprIds: Array[ExprId] = []
    mut val patternIds: Array[PatternId] = []
    mut val matchArmIds: Array[MatchArmId] = []
    mut val argIds: Array[ArgId] = []
    mut val makeFieldIds: Array[MakeFieldId] = []
    mut val bindIds: Array[BindId] = []
    mut val deriveReqIds: Array[DeriveReqId] = []
    mut val directiveIds: Array[DirectiveId] = []
    // A pool of slice descriptors preserves each independently-sized nested
    // group, notably extern opaque-type generic parameter lists.
    mut val slices: Array[SyntaxSlice] = []
    mut val texts: Array[Span] = []
    mut val bools: Array[Bool] = []
}

// Raw declaration-side nodes. `Span` is also the text reference: all parser
// input lives in the compiler source arena, so copying a spelling into String is
// neither necessary nor desirable on the compiler path.
export struct SyntaxType {
    pub val name: Span
    pub val args: SyntaxSlice
    pub val span: Span
    pub val extView: Span
    pub val viewNames: SyntaxSlice
    pub val projectionTrait: Span
    pub val projectionTraitArgs: SyntaxSlice
    pub val projectionTraitArgLabels: SyntaxSlice
    pub val projectionAssoc: Span
    pub val isAny: Bool
    pub val argLabels: SyntaxSlice
    pub val isSendable: Bool
    pub val isRecord: Bool
}

export struct SyntaxField {
    pub val name: Span
    pub val ty: TypeId
    pub val isMut: Bool
    pub val vis: U64
    pub val hasDefault: Bool
    pub val defaultVal: ExprId
    pub val span: Span
}

export struct SyntaxVariant {
    pub val name: Span
    pub val fields: SyntaxSlice
    pub val span: Span
}

export struct SyntaxParam {
    pub val name: Span
    pub val ty: TypeId
    pub val isInout: Bool
    pub val isMove: Bool
    pub val isBorrow: Bool
    pub val noLabel: Bool
    pub val hasDefault: Bool
    pub val defaultVal: ExprId
    pub val span: Span
}

export struct SyntaxDecl {
    pub val kind: DeclKind
    pub val name: Span
    pub val typeParams: SyntaxSlice
    pub val typeParamSendable: SyntaxSlice
    pub val span: Span
    pub val isUnique: Bool
    pub val isNonsendable: Bool
    pub val fields: SyntaxSlice
    pub val hasDeinit: Bool
    pub val deinitBody: BlockId
    pub val variants: SyntaxSlice
    pub val params: SyntaxSlice
    pub val hasRet: Bool
    pub val ret: TypeId
    pub val isAsync: Bool
    pub val whereParams: SyntaxSlice
    pub val whereTraits: SyntaxSlice
    pub val whereTypes: SyntaxSlice
    pub val whereTraitTypes: SyntaxSlice
    pub val body: BlockId
}

export struct SyntaxMember {
    pub val kind: MemberKind
    pub val name: Span
    pub val typeParams: SyntaxSlice
    pub val typeParamSendable: SyntaxSlice
    pub val params: SyntaxSlice
    pub val hasRet: Bool
    pub val ret: TypeId
    pub val whereParams: SyntaxSlice
    pub val whereTraits: SyntaxSlice
    pub val whereTypes: SyntaxSlice
    pub val whereTraitTypes: SyntaxSlice
    pub val isAsync: Bool
    pub val selfInout: Bool
    pub val selfMove: Bool
    pub val isVia: Bool
    pub val viaName: Span
    pub val body: BlockId
    pub val assocTy: TypeId
    pub val isFactory: Bool
    pub val factoryKind: U64
    pub val factoryErr: TypeId
}

export struct SyntaxSig {
    pub val name: Span
    pub val typeParams: SyntaxSlice
    pub val typeParamSendable: SyntaxSlice
    pub val params: SyntaxSlice
    pub val hasRet: Bool
    pub val ret: TypeId
    pub val isAssoc: Bool
    pub val selfInout: Bool
}

export struct SyntaxTrait {
    pub val name: Span
    pub val typeParams: SyntaxSlice
    pub val typeParamSendable: SyntaxSlice
    pub val supertraits: SyntaxSlice
    pub val reqs: SyntaxSlice
    pub val assocTypes: SyntaxSlice
    pub val span: Span
}

export struct SyntaxExtern {
    pub val abiOk: Bool
    pub val abiC: Bool
    pub val abiSpan: Span
    pub val fns: SyntaxSlice
    pub val structNames: SyntaxSlice
    pub val structTypeParams: SyntaxSlice
    pub val structTypeParamSendable: SyntaxSlice
    pub val structSpans: SyntaxSlice
    pub val structDirectives: SyntaxSlice
    pub val span: Span
}

export struct SyntaxImpl {
    pub val recvType: TypeId
    pub val implParams: SyntaxSlice
    pub val implParamSendable: SyntaxSlice
    pub val isTraitImpl: Bool
    pub val traitName: Span
    pub val traitNameSpan: Span
    pub val traitArgs: SyntaxSlice
    pub val whereParams: SyntaxSlice
    pub val whereTraits: SyntaxSlice
    pub val whereTypes: SyntaxSlice
    pub val whereTraitTypes: SyntaxSlice
    pub val isPub: Bool
    pub val members: SyntaxSlice
    pub val span: Span
    pub val extName: Span
}

export struct SyntaxImport {
    pub val path: Span
    pub val segment: Span
    pub val isImport: Bool
    pub val nameSpans: SyntaxSlice
    pub val alias: Span
    pub val nameAliases: SyntaxSlice
    pub val span: Span
}

export struct SyntaxDeriveReq {
    pub val name: Span
    pub val args: SyntaxSlice
}

export struct SyntaxDirective {
    pub val reqs: SyntaxSlice
}

export struct SyntaxNewtype {
    pub val name: Span
    pub val ty: TypeId
    pub val isPub: Bool
    pub val span: Span
}

// Expression/body-side nodes use one tagged scalar record per category.  The tag
// is closed and every child is an ID or a flat slice; fields irrelevant to a tag
// are zero/empty.  This avoids a nested enum payload while preserving all source
// forms for a direct compiler lowering.
export enum SyntaxExprKind {
    IntLit
    FloatLit
    StrLit
    Ident
    Unary
    Binary
    Call
    Field
    Method
    ExtMethod
    ExtView
    Index
    Make
    ArrayLit
    DictLit
    RecordLit
    Cast
    MatchExpr
    IfExpr
    OptChain
    ChainHole
    Try
    Arrow
    ArrowMethod
    Closure
    Move
    Await
    // The value parser currently represents source `a..<b` / `a..=b` as a
    // synthetic Make of a prelude range type.  SyntaxFile retains the surface
    // construct instead: no synthesized type/field String enters the arena.
    Range
}

export struct SyntaxExpr {
    pub val kind: SyntaxExprKind
    pub val span: Span
    pub val text: Span
    pub val name: Span
    pub val nameSpan: Span
    pub val op: I64
    // Preserve the parser literal payload exactly; signed interpretation belongs
    // to type checking, not syntax storage.
    pub val intValue: U64
    pub val flag0: Bool
    pub val flag1: Bool
    pub val child0: ExprId
    pub val child1: ExprId
    pub val child2: ExprId
    pub val type0: TypeId
    pub val block0: BlockId
    pub val block1: BlockId
    pub val args: SyntaxSlice
    pub val elems: SyntaxSlice
    pub val keys: SyntaxSlice
    pub val values: SyntaxSlice
    pub val fields: SyntaxSlice
    pub val arms: SyntaxSlice
    pub val params: SyntaxSlice
    pub val typeArgs: SyntaxSlice
}

export struct SyntaxArg {
    pub val label: Span
    pub val hasLabel: Bool
    pub val isInout: Bool
    pub val value: ExprId
    pub val span: Span
}

export struct SyntaxMakeField {
    pub val name: Span
    pub val value: ExprId
    pub val span: Span
}

export struct SyntaxBind {
    pub val field: Span
    pub val name: Span
    pub val fieldStart: U64
    pub val span: Span
    pub val isAssign: Bool
}

export struct SyntaxPattern {
    pub val isWildcard: Bool
    pub val isStruct: Bool
    pub val typeName: Span
    pub val variant: Span
    pub val binds: SyntaxSlice
    pub val isLiteral: Bool
    pub val lit: ExprId
    pub val captureName: Span
    pub val span: Span
}

export struct SyntaxMatchArm {
    pub val pat: PatternId
    pub val body: BlockId
    pub val span: Span
}

export struct SyntaxBlock {
    pub val stmts: SyntaxSlice
}

export enum SyntaxStmtKind {
    Let
    Assign
    ExprStmt
    Return
    If
    While
    For
    Match
    Panic
    Give
    Break
    Continue
    Destructure
}

export struct SyntaxStmt {
    pub val kind: SyntaxStmtKind
    pub val span: Span
    pub val name: Span
    pub val typeName: Span
    pub val op: I64
    pub val flag0: Bool
    pub val flag1: Bool
    pub val flag2: Bool
    pub val flag3: Bool
    // A record loop pattern is lowered through the same get-element plus
    // destructure semantics as `(val x, val y) = element`. The value parser
    // marks it with a private synthetic patType spelling; retain the semantic
    // distinction explicitly instead of asking compiler consumers to infer it
    // from unrelated empty spans.
    pub val isRecordPattern: Bool = false
    pub val child0: ExprId
    pub val child1: ExprId
    pub val child2: ExprId
    pub val type0: TypeId
    pub val block0: BlockId
    pub val block1: BlockId
    pub val arms: SyntaxSlice
    pub val binds: SyntaxSlice
}

export struct TypeParamListAst {
    pub val names: Array[String]
    pub val isSendable: Array[Bool]
    // Exact source span parallel to `names`; required when the compiler-facing
    // arena interns a generic binder without retaining its String.
    pub val nameSpans: Array[Span] = []
}

// A type expression. `Array[U8]` -> name="Array", args=[U8]; a bare `T` ->
// name="T", args=[]. (Function types `fn(...)->T` are an additive follow-up.)
export struct TypeAst {
    pub val name: String
    // Exact source spelling of `name`. `span` covers the complete type expression
    // (and may begin at `any`/`sendable`), so it cannot substitute for this when a
    // compiler-facing SyntaxFile interns the head without retaining a String.
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val args: Array[TypeAst]
    pub val span: Span
    // `Person#Ext` (spec/09): an extension-view refinement of the type. "" for a
    // plain type. A zero-cost view (same runtime layout) that selects which
    // extension's methods/witnesses resolve; treated as an invariant type detail.
    pub val extView: String = ""
    pub val extViewSpan: Span = <Span start=0 end=0 />
    // Source selectors written after a type head, in source order.  The compiler
    // canonicalizes them into an unordered extension set plus one optional trait
    // selector; keeping the raw list here lets the parser accept `T#E#P` without
    // assigning extension/trait meaning before declarations are available.
    pub val viewNames: Array[String] = []
    pub val viewNameSpans: Array[Span] = []
    // Associated-type projection (spec/08): `T#Trait[Args].Item` stores the
    // resolved source spelling and its positional instance arguments.  The
    // short form `T.Item` leaves projectionTrait empty.
    pub val projectionTrait: String = ""
    pub val projectionTraitSpan: Span = <Span start=0 end=0 />
    pub val projectionTraitArgs: Array[TypeAst] = []
    pub val projectionTraitArgLabels: Array[String] = []
    pub val projectionTraitArgLabelSpans: Array[Span] = []
    pub val projectionAssoc: String = ""
    pub val projectionAssocSpan: Span = <Span start=0 end=0 />
    // `any P` (spec/08): an existential — a type-erased value of any concrete type
    // conforming to trait `name`. false for a plain type. Runtime layout is a fat
    // pointer `{ data, vtable }` (vs the plain type's own layout), so this is part
    // of type identity, not a zero-cost view.
    pub val isAny: Bool = false
    // binding labels parallel to `args` (spec/08 existential formation / spec/12
    // associated-type binding): for `any Add[I32, Output=I32]`, args=[I32, I32] and
    // argLabels=["", "Output"] — "" marks a positional type argument, a non-empty
    // label marks a named associated-type / type-parameter binding `Name=Type`.
    // Empty (or all "") for an ordinary generic type like `Array[I32]`.
    pub val argLabels: Array[String] = []
    pub val argLabelSpans: Array[Span] = []
    // A type-level sendability assertion/requirement written in the surface syntax:
    // `[sendable T]` marks a type parameter, `any sendable P` marks an existential
    // guarantee, and `sendable fn(...) -> R` marks a function value capability. This
    // is representation only here; semantic checking is a later compiler phase.
    pub val isSendable: Bool = false
    // a labelled anonymous record type `(x: I32, y: I32)` (spec/02): a structural,
    // nameless record. `args` holds the field types and `argLabels` the field names
    // (parallel). `name` is empty. The type lowers to a synthetic struct keyed by its
    // sorted (name, type) set, so two records with the same fields are the same type.
    pub val isRecord: Bool = false
}

// A struct field / enum-variant payload field. For a variant payload field,
// `isMut` is false and `vis` is 0 (variants take no modifiers). `vis`: 0 = private,
// 1 = pub(get), 2 = pub (matches the compiler's encoding). A default value
// (`val x: T = expr`) is flagged by `hasDefault` and surfaced in `defaultVal` (an
// `emptyExpr()` placeholder when absent).
export struct FieldAst {
    pub val name: String
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val ty: TypeAst
    pub val isMut: Bool
    pub val vis: U64
    pub val hasDefault: Bool
    pub val defaultVal: ExprAst
    pub val span: Span
}

// An enum variant. `fields` is the record payload `V(x: I32, y: I32)`; empty for a
// payload-less variant `V`.
export struct VariantAst {
    pub val name: String
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val fields: Array[FieldAst]
    pub val span: Span
}

// A function parameter. Access modes (spec/03): `inout`/`move`/`borrow`. A
// label-suppressed `name~: T` sets `noLabel`. A default value (`name: T = expr`) is
// flagged by `hasDefault` and surfaced in `defaultVal` (`emptyExpr()` when absent).
export struct ParamAst {
    pub val name: String
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val ty: TypeAst
    pub val isInout: Bool
    pub val isMove: Bool
    pub val isBorrow: Bool
    pub val noLabel: Bool
    pub val hasDefault: Bool
    pub val defaultVal: ExprAst
    pub val span: Span
}

// Which kind of declaration a `DeclAst` is.
export enum DeclKind {
    Struct
    Enum
    Func
}

// The parsed top-level item a macro is attached to. A tagged record: `kind`
// selects struct / enum / fn, and the kind-specific fields below are populated
// accordingly (the others stay empty). A `Derive` switches on `kind` and reads
// the relevant fields.
//
// (This is a flat tagged struct rather than an `enum DeclAst { Struct(StructDecl)
// … }` because the C backend does not yet emit nominal bodies in dependency
// order — an enum holding a struct payload by value would forward-reference an
// incomplete type. A struct holding an enum tag + struct fields by value is fine.
// Restoring the enum form is a follow-up once the backend topologically orders
// nominal bodies.)
export struct DeclAst {
    pub val kind: DeclKind
    pub val name: String
    // the NAME token's span (original coordinates). Distinct from `span` (the whole
    // declaration, keyword..closing brace). The compiler frontend needs the name's
    // ORIGINAL offset for a `fn`/`struct`/`enum` declaration so `moduleOf` (cross-
    // module visibility) attributes it to the right module.
    pub val nameSpan: Span
    pub val typeParams: Array[String]
    pub val typeParamSpans: Array[Span] = []
    pub val typeParamSendable: Array[Bool] = []
    pub val span: Span
    // struct/enum (`kind == Struct` or `kind == Enum`)
    pub val isUnique: Bool
    pub val isNonsendable: Bool = false
    pub val fields: Array[FieldAst]
    // struct `deinit { ... }` (spec/03): the parsed block, flagged by `hasDeinit`.
    // A macro can read it; the compiler lowers it to a synthetic `Type_deinit` method.
    pub val hasDeinit: Bool
    pub val deinitBody: BlockAst
    // enum (`kind == Enum`)
    pub val variants: Array[VariantAst]
    // fn (`kind == Func`)
    pub val params: Array[ParamAst]
    pub val hasRet: Bool
    pub val ret: TypeAst
    // `async fn` (spec/14): the function is a stackless state machine returning a
    // Promise. Default false. (The caller of a top-level `async fn` consumes the
    // `async` keyword and threads it in.)
    pub val isAsync: Bool
    // `where T: A + B, U: C` trait bounds (spec/08), as parallel lists: each
    // atom (one trait per `+`/`,` expansion) has its subject name, full trait
    // type, and subject type.  The full trait TypeAst retains positional trait
    // arguments and associated-type bindings (`T: Add[I64]`), not just its head.
    pub val whereParams: Array[String]
    pub val whereTraits: Array[String]
    pub val whereTypes: Array[TypeAst] = []
    pub val whereTraitTypes: Array[TypeAst] = []
    // fn body (`kind == Func`): the parsed `{ ... }` block (empty for struct/enum
    // and for a body-less signature). Lets a macro read/transform a function body.
    pub val body: BlockAst
}

// An empty type expression (placeholder for a missing/absent type position).
export fn emptyTypeAst() -> TypeAst {
    return <TypeAst name="" args=[] span=<Span start=0 end=0 /> />
}

// Which kind of member a `MemberAst` is inside an `impl` block (spec/07,08).
export enum MemberKind {
    Method      // `[inout|move|borrow] fn` / `async [move] fn` — has self
    AssocFn     // `assoc fn` — namespaced on the type, no self
    Deinit      // `deinit { ... }` — synthetic Type_deinit method
    AssocType   // `type Item = Concrete` — conformance's associated-type binding
    Factory     // `factory` — publishes the default memberwise factory (spec/05): in
                // a `pub impl T { }` it makes `<T …/>` constructible from other modules
}

// A member of an `impl` block. A tagged record (`kind` selects the shape; the
// kind-specific fields below are populated accordingly). For Method/AssocFn it is
// a function signature + body (or a `via real` alias); for Deinit just a body; for
// AssocType a name + bound type.
export struct MemberAst {
    pub val kind: MemberKind
    pub val name: String
    pub val nameSpan: Span
    pub val typeParams: Array[String]
    pub val typeParamSpans: Array[Span] = []
    pub val typeParamSendable: Array[Bool] = []
    pub val params: Array[ParamAst]
    pub val hasRet: Bool
    pub val ret: TypeAst
    pub val whereParams: Array[String]
    pub val whereTraits: Array[String]
    pub val whereTypes: Array[TypeAst] = []
    pub val whereTraitTypes: Array[TypeAst] = []
    // `async fn` method (spec/14). `selfInout` = `inout fn` (mutable self),
    // `selfMove` = `move fn`/`async move fn` (consuming self). A plain/`borrow fn`
    // has both false.
    pub val isAsync: Bool
    pub val selfInout: Bool
    pub val selfMove: Bool
    // `fn req(...) -> T via real` (spec/08): witnesses a requirement by aliasing an
    // existing method `real` (no body). `viaName` is `real`.
    pub val isVia: Bool
    pub val viaName: String
    pub val viaNameSpan: Span = <Span start=0 end=0 />
    // Method/AssocFn/Deinit body (empty for `via` and AssocType).
    pub val body: BlockAst
    // AssocType's bound type `type Item = <assocTy>`.
    pub val assocTy: TypeAst
    // a custom `factory [name](params) { … }` (spec/05): lowered as an AssocFn whose
    // return type is the impl's type (the implicit `Self`). Invoked via `<Type.name …/>`.
    pub val isFactory: Bool = false
    // a fallible factory's wrapper (spec/05): 0 = plain (`-> Self`), 1 = `optional`
    // (`-> Optional[Self]`), 2 = `result[E]` (`-> Result[Self, E]`). factoryErr is the
    // error type `E` for kind 2.
    pub val factoryKind: U64 = 0
    pub val factoryErr: TypeAst = emptyTypeAst()
}

// A body-less function signature: a trait requirement (`fn req(...) -> T`) or an
// `extern(plewIntrinsic)` declaration (spec/08,15). `name`/`nameSpan` keep the
// original coordinates (an extern fn name feeds moduleOf for cross-module calls).
export struct SigAst {
    pub val name: String
    pub val nameSpan: Span
    pub val typeParams: Array[String]
    pub val typeParamSpans: Array[Span] = []
    pub val typeParamSendable: Array[Bool] = []
    pub val params: Array[ParamAst]
    pub val hasRet: Bool
    pub val ret: TypeAst
    pub val isAssoc: Bool
    // `inout fn` requirement (spec/08): the method mutates `self`. Conformance still
    // matches by selector, not self-mode, but the existential dispatch needs it to
    // pass the boxed self by pointer (a mutating method on `any P` — `inout next()`).
    pub val selfInout: Bool = false
}

// A `trait Name [: Super + ...] { requirements }` declaration (spec/08). The body
// holds only requirement signatures (no bodies) + associated-type names.
export struct TraitAst {
    pub val name: String
    pub val nameSpan: Span
    // trait type parameters `trait Add[Rhs]` (spec/12): the right-operand-type
    // parameter of operator traits and any other trait type args. Empty for a
    // non-parameterized trait (Eq/Ord/Hasher).
    pub val typeParams: Array[String]
    pub val typeParamSpans: Array[Span] = []
    pub val typeParamSendable: Array[Bool] = []
    pub val supertraits: Array[String]
    pub val supertraitSpans: Array[Span] = []
    pub val reqs: Array[SigAst]
    pub val assocTypes: Array[String]
    pub val assocTypeSpans: Array[Span] = []
    pub val span: Span
}

// An `extern(<abi>) { fn ... ; struct/type ... }` block (spec/15).
// `abiOk` is true iff the bareword ABI is `plewIntrinsic` or `c`; `abiSpan`
// points at the `extern` keyword for the error. `fns` are body-less signatures;
// `structNames`/`structSpans` are opaque intrinsic or foreign-C types.
export struct ExternAst {
    pub val abiOk: Bool
    // true iff the ABI is the C ABI (`extern(c)` — spec/15 FFI). Distinguishes a
    // foreign-C block (raw symbol names, emitted prototypes) from the intrinsic
    // floor (`extern(plewIntrinsic)`, runtime `plew_*`).
    pub val abiC: Bool = false
    pub val abiSpan: Span
    pub val fns: Array[SigAst]
    pub val structNames: Array[String]
    pub val structNameSpans: Array[Span] = []
    // per-struct generic type-parameter names (parallel to structNames; empty = a
    // non-generic opaque type). Lets a generic opaque intrinsic — `struct Buffer[T]` —
    // be registered as a real generic struct (so its `Buffer[E]` uses are generic
    // instances dispatched uniformly), distinct from non-generic `struct Ref`.
    pub val structTypeParams: Array[Array[String]] = []
    pub val structTypeParamSpans: Array[Array[Span]] = []
    pub val structTypeParamSendable: Array[Array[Bool]] = []
    // per-struct source span covering `struct Name` (the whole item), so a `@[...]`
    // derive on an extern struct can feed `parseItem` the item's source (spec/16).
    pub val structSpans: Array[Span]
    // per-struct `@[...]` directive (parallel to structNames; empty `reqs` = none).
    // Lets a derive macro target an opaque lang-item / FFI type declared in an extern
    // block (spec/15,16) — e.g. `@[IntTryFrom(...)] struct I8`.
    pub val structDirectives: Array[DirectiveAst]
    pub val span: Span
}

// An `[pub] impl[T] Recv [as Trait] [where ...] { members }` block (spec/07,08).
// `recvType` carries the receiver type (its head name is the type the members are
// registered on; the `[T]` args are redundant with `implParams`).
export struct ImplAst {
    pub val recvType: TypeAst
    pub val implParams: Array[String]
    pub val implParamSpans: Array[Span] = []
    pub val implParamSendable: Array[Bool] = []
    pub val isTraitImpl: Bool
    pub val traitName: String
    // Original occurrence after `as`, retained so lowering can resolve a
    // module-local import alias at its actual use site.
    pub val traitNameSpan: Span = <Span start=0 end=0 />
    // trait type arguments `impl V as Add[V]` (spec/12): bind the trait's type
    // parameters to concrete types. Empty for a bare `impl V as Trait`.
    pub val traitArgs: Array[TypeAst]
    // impl-level `where I: Trait` (spec/08): folded into every member's bounds.
    pub val whereParams: Array[String]
    pub val whereTraits: Array[String]
    pub val whereTypes: Array[TypeAst] = []
    pub val whereTraitTypes: Array[TypeAst] = []
    pub val isPub: Bool
    pub val members: Array[MemberAst]
    pub val span: Span
    // the enclosing `extension Name { ... }` (spec/09), "" for a bare impl. An
    // extension impl's members do not join bare resolution; they are reached only
    // through a call-site `value#Name.member` view.
    pub val extName: String = ""
    pub val extNameSpan: Span = <Span start=0 end=0 />
}

// An `import <path> [with { name [as Q], ... }]` statement (spec/15). `pathSpan` is
// the full contiguous path text (`@Std/Io` / `./Foo` / `/Models/User`) in original
// coordinates — the loader resolves it to a file (parse-driven loading). `segSpan`
// is the last path segment (the submodule). Each `with` name keeps its original span
// (the importing-side occurrence — feeds moduleOf for the importing module).
export struct ImportAst {
    pub val pathSpan: Span
    pub val segSpan: Span
    pub val isImport: Bool
    pub val names: Array[String]
    pub val nameSpans: Array[Span]
    // a path-level alias `import <path> as F` (spec/15): binds the namespace to `F`
    // instead of the last path segment. Empty span when absent.
    pub val aliasSpan: Span = <Span start=0 end=0 />
    // per-name aliases for `with { Bar as Q }` (spec/15), parallel to `names`. An
    // empty span means the name is imported under its own name.
    pub val nameAliasSpans: Array[Span] = []
    pub val span: Span
}

// One `@[Name(label: expr, ...)]` derive request: the macro/derive name + its
// directive arguments (each a labelled value that becomes a field on the constructed
// macro struct). `nameSpan` keeps the original coordinates (text-matched downstream).
export struct DeriveReqAst {
    pub val name: String
    pub val nameSpan: Span
    pub val args: Array[MakeFieldAst]
}

// An `@[Eq, Ord, Name(a: 32), ...]` directive (spec/16): the comma-separated derive
// requests applied to the next type declaration.
export struct DirectiveAst {
    pub val reqs: Array[DeriveReqAst]
}

// A top-level item of a program (spec/15). The shared `parseProgramAst` returns a
// list of these; the compiler frontend lowers each (Codegen/Lower.pw) into its arena
// or Comp state, and follows `Import` nodes to load further files. `Export` wraps the
// exported inner item (recursive — auto-boxed); `ReExport` is an `export <path> with
// { … }` (a pure forwarding re-export, spec/15): it carries the same `ImportAst` an
// `import` would (path + selected names + aliases) so the loader can load the
// forwarded module and the frontend can republish its names — but unlike `import` it
// binds NOTHING locally (forwarding only). `imp.isImport` is true (it resolves a fresh
// module like an import); the `ReExport` wrapper is what marks it as forward-only.
export enum TopItemAst {
    Decl(d: DeclAst)
    Impl(im: ImplAst)
    Trait(t: TraitAst)
    Extern(e: ExternAst)
    Import(imp: ImportAst)
    Export(inner: TopItemAst)
    ReExport(imp: ImportAst)
    Directive(dir: DirectiveAst)
    // a module-level variable (spec/15): `val x = e` / `mut val x = e`. The payload
    // is the same `StmtAst.Let` the local-binding parser produces (name / optional
    // type / initializer); the frontend lowers it to a `Comp.globals` entry and the
    // backend emits an LLVM global initialized once before `main` runs.
    GlobalVal(s: StmtAst)
    // a named type (spec/10): `newtype Meter = F64`. `name` is the distinct type; `ty`
    // is the underlying. Same representation as the underlying (a zero-cost `as`
    // re-tag), but a distinct type identity that inherits the underlying's methods.
    NewType(name: String, nameSpan: Span, ty: TypeAst, isPub: Bool, span: Span)
}

export struct ArgAst {
    pub val label: String
    pub val labelSpan: Span = <Span start=0 end=0 />
    pub val hasLabel: Bool
    pub val isInout: Bool
    pub val value: ExprAst
    pub val span: Span
}

// A field binding in a JSX construction `<T field=expr />`.
export struct MakeFieldAst {
    pub val name: String
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val value: ExprAst
    pub val span: Span
}

// One field bind inside a pattern. `field` is the variant/struct field read;
// `name` is the local introduced (equal for punning `val x`). `fieldStart` is
// the absolute source offset of the token that spells the field name (the
// explicit label, or the bound name when punned) — the source bytes there ARE
// the field name, so consumers can reference the field by source span directly
// (precise diagnostics, no interning).
export struct BindAst {
    pub val field: String
    pub val name: String
    pub val fieldStart: U64
    pub val fieldSpan: Span = <Span start=0 end=0 />
    pub val nameSpan: Span = <Span start=0 end=0 />
    pub val span: Span
    // a destructure-statement element written WITHOUT `val` assigns the field to an
    // EXISTING `mut val` binding instead of declaring a new one (`(x, val y) = r`,
    // spec/03). Always false in match/for patterns, which only bind.
    pub val isAssign: Bool = false
}

// A match pattern (everything before `=>`): wildcard `_`, an enum variant
// `E.V(binds)`, a struct destructure `S { binds }`, or a bare literal `0`/`"x"`/
// `true`/`-1` (isLiteral; `lit` is the literal expression — spec/11). A literal
// match desugars in lowering to a temp-bound `==` if/else chain, so the arena
// never sees a literal pattern.
export struct PatternAst {
    pub val isWildcard: Bool
    pub val isStruct: Bool
    pub val typeName: String
    pub val typeNameSpan: Span = <Span start=0 end=0 />
    pub val variant: String
    pub val variantSpan: Span = <Span start=0 end=0 />
    pub val binds: Array[BindAst]
    pub val isLiteral: Bool = false
    pub val lit: ExprAst = emptyExpr()
    // a capture binding `val x` — a named wildcard that binds the whole scrutinee to
    // `captureName` (spec/11). isWildcard is also true; captureName is "" for a plain `_`.
    pub val captureName: String = ""
    pub val captureNameSpan: Span = <Span start=0 end=0 />
    pub val span: Span
}

// One match arm: a pattern and a body block (a single-`give` block in expression
// position). `match` arms have NO guards (spec/11): refinement is done by binding
// then a nested `match`, or a preceding `if`/`guard` condition chain — this keeps
// exhaustiveness purely structural.
export struct MatchArmAst {
    pub val pattern: PatternAst
    pub val body: BlockAst
    pub val span: Span
}

// A `{ ... }` block: a sequence of statements.
export struct BlockAst {
    pub val stmts: Array[StmtAst]
}

// An expression. `op` fields carry the operator's lexer kind code (kindCode).
export enum ExprAst {
    IntLit(value: U64, isBool: Bool, tySuffix: String, literalSpan: Span, tySuffixSpan: Span, span: Span)
    FloatLit(text: String, tySuffix: String, literalSpan: Span, tySuffixSpan: Span, span: Span)
    StrLit(raw: String, span: Span)
    Ident(name: String, span: Span)
    Unary(op: I64, operand: ExprAst, span: Span)
    Binary(op: I64, lhs: ExprAst, rhs: ExprAst, span: Span)
    Call(name: String, nameSpan: Span, args: Array[ArgAst], span: Span)
    // `nameSpan` is the member name's own source span (the whole `span` starts at the
    // base) — consumers reference the field by SOURCE bytes for precise diagnostics.
    Field(base: ExprAst, name: String, nameSpan: Span, span: Span)
    // `nameSpan` is the method name's own source span (the whole-call `span` starts at
    // the receiver), needed to recover the name's original offset for a namespace call
    // `Namespace.fn(args)` (spec/15).
    Method(recv: ExprAst, name: String, nameSpan: Span, args: Array[ArgAst], span: Span)
    // `recv#Ext.name(args)` (spec/09): a method call through an extension view.
    // `src` is the extension (or trait) name selecting the method source.
    ExtMethod(recv: ExprAst, src: String, srcSpan: Span, name: String, nameSpan: Span, args: Array[ArgAst], span: Span)
    // `recv#Ext` / `recv#!Ext` (spec/09): a zero-cost value re-view. `strip=false`
    // selects extension `src` (the static type gains the `#Ext` view); `strip=true`
    // removes it (`#!Ext`, the "super" form — a following `.method()` resolves the
    // shadowed bare method). The value is unchanged either way.
    ExtView(recv: ExprAst, src: String, srcSpan: Span, strip: Bool, span: Span)
    Index(base: ExprAst, index: ExprAst, span: Span)
    Make(typeName: String, typeNameSpan: Span, typeArgs: Array[TypeAst], variant: String, variantSpan: Span, isEnum: Bool, fields: Array[MakeFieldAst], span: Span)
    ArrayLit(elems: Array[ExprAst], span: Span)
    DictLit(keys: Array[ExprAst], vals: Array[ExprAst], span: Span)
    // a labelled anonymous record literal `(x: 1, y: 2)` (spec/02). `fields` reuses
    // MakeFieldAst (label + value). The field types come from each value (or the
    // context type); it lowers to a synthetic struct construction.
    RecordLit(fields: Array[MakeFieldAst], span: Span)
    Cast(operand: ExprAst, ty: TypeAst, span: Span)
    MatchExpr(scrut: ExprAst, arms: Array[MatchArmAst], span: Span)
    IfExpr(cond: ExprAst, thenBlk: BlockAst, elseBlk: BlockAst, span: Span)
    // `base?.<cont>` optional chaining (spec/12): `cont` is the trailing member-access
    // chain applied to the UNWRAPPED base value, rooted at a `ChainHole` placeholder
    // (`a?.b.c` -> cont = Field(Field(ChainHole, b), c)). Swift-style propagation — the
    // whole `cont` is short-circuited when the base is empty. `memberSpan` is the first
    // member's source token (diagnostics anchor).
    OptChain(base: ExprAst, cont: ExprAst, memberSpan: Span, span: Span)
    // The unwrapped-base placeholder at the root of an `OptChain`'s `cont`. Only ever
    // appears inside an `OptChain`; the desugar substitutes the bound chain value for it.
    ChainHole(span: Span)
    Try(operand: ExprAst, span: Span)
    Arrow(base: ExprAst, name: String, nameSpan: Span, span: Span)
    // `base->name(args)` (spec/03): a method call on the POINTEE of a `Ref` (the `->`
    // counterpart of `Method`'s `.`). Distinct from `Arrow` (pointee FIELD access) so the
    // backend dispatches `name` on the pointee struct with the cell as the receiver place.
    ArrowMethod(recv: ExprAst, name: String, nameSpan: Span, args: Array[ArgAst], span: Span)
    Closure(params: Array[ParamAst], hasRet: Bool, ret: TypeAst, body: BlockAst, span: Span)
    Move(operand: ExprAst, isBorrow: Bool, span: Span)
    Await(operand: ExprAst, span: Span)
}

// The source span of any expression node (every variant carries one).
export fn exprAstSpan(e: ExprAst) -> Span {
    match e {
        ExprAst.IntLit(value: _, isBool: _, tySuffix: _, literalSpan: _, tySuffixSpan: _, val span) => { return span }
        ExprAst.FloatLit(text: _, tySuffix: _, literalSpan: _, tySuffixSpan: _, val span) => { return span }
        ExprAst.StrLit(raw: _, val span) => { return span }
        ExprAst.Ident(name: _, val span) => { return span }
        ExprAst.Unary(op: _, operand: _, val span) => { return span }
        ExprAst.Binary(op: _, lhs: _, rhs: _, val span) => { return span }
        ExprAst.Call(name: _, nameSpan: _, args: _, val span) => { return span }
        ExprAst.Field(base: _, name: _, nameSpan: _, val span) => { return span }
        ExprAst.Method(recv: _, name: _, nameSpan: _, args: _, val span) => { return span }
        ExprAst.ExtMethod(recv: _, src: _, srcSpan: _, name: _, nameSpan: _, args: _, val span) => { return span }
        ExprAst.ExtView(recv: _, src: _, srcSpan: _, strip: _, val span) => { return span }
        ExprAst.Index(base: _, index: _, val span) => { return span }
        ExprAst.Make(typeName: _, typeNameSpan: _, typeArgs: _, variant: _, variantSpan: _, isEnum: _, fields: _, val span) => { return span }
        ExprAst.ArrayLit(elems: _, val span) => { return span }
        ExprAst.DictLit(keys: _, vals: _, val span) => { return span }
        ExprAst.RecordLit(fields: _, val span) => { return span }
        ExprAst.Cast(operand: _, ty: _, val span) => { return span }
        ExprAst.MatchExpr(scrut: _, arms: _, val span) => { return span }
        ExprAst.IfExpr(cond: _, thenBlk: _, elseBlk: _, val span) => { return span }
        ExprAst.OptChain(base: _, cont: _, memberSpan: _, val span) => { return span }
        ExprAst.ChainHole(val span) => { return span }
        ExprAst.Try(operand: _, val span) => { return span }
        ExprAst.Arrow(base: _, name: _, nameSpan: _, val span) => { return span }
        ExprAst.ArrowMethod(recv: _, name: _, nameSpan: _, args: _, val span) => { return span }
        ExprAst.Closure(params: _, hasRet: _, ret: _, body: _, val span) => { return span }
        ExprAst.Move(operand: _, isBorrow: _, val span) => { return span }
        ExprAst.Await(operand: _, val span) => { return span }
    }
}

// A statement.
export enum StmtAst {
    Let(mutable: Bool, name: String, nameSpan: Span, hasTy: Bool, ty: TypeAst, init: ExprAst, span: Span)
    Assign(op: I64, target: ExprAst, value: ExprAst, span: Span)
    ExprStmt(expr: ExprAst, span: Span)
    Return(value: ExprAst, hasValue: Bool, span: Span)
    If(cond: ExprAst, thenBlk: BlockAst, elseBlk: BlockAst, hasElse: Bool, span: Span)
    While(cond: ExprAst, body: BlockAst, span: Span)
    For(varName: String, varNameSpan: Span, varTy: TypeAst, hasVarTy: Bool, isRange: Bool, inclusive: Bool, iter: ExprAst, rangeHi: ExprAst, body: BlockAst, isStruct: Bool, patType: String, patTypeSpan: Span, binds: Array[BindAst], span: Span)
    Match(scrut: ExprAst, arms: Array[MatchArmAst], span: Span)
    Panic(msg: ExprAst, span: Span)
    Give(value: ExprAst, span: Span)
    Break(span: Span)
    Continue(span: Span)
    // a record-destructuring binding `(val x, val y) = expr` (spec/02,03): each bind is
    // a field of the record value `init`. Punning `(val x)` is field=name=x; explicit
    // `(a: val x)` is field=a name=x. Lowers to a temp binding plus one `val` per field.
    Destructure(binds: Array[BindAst], typeName: String, typeNameSpan: Span, init: ExprAst, span: Span)
}

// A placeholder expression (an absent value position, e.g. `return` with no value).
export fn emptyExpr() -> ExprAst {
    return <ExprAst.IntLit value=0 isBool=false tySuffix="" literalSpan=<Span start=0 end=0 /> tySuffixSpan=<Span start=0 end=0 /> span=<Span start=0 end=0 /> />
}

// An empty block.
export fn emptyBlock() -> BlockAst {
    return <BlockAst stmts=[] />
}

export struct P {
    pub val bytes: Array[U8]
    pub val toks: Array[Tok]
    pub mut val pos: U64
    pub val base: U64
    // recoverable error state: the parser keeps going (for macro robustness) but
    // records the first syntax error (original-coordinate offset + message). The
    // compiler frontend checks `hasErr` after a parse and reports it loudly; a macro
    // can inspect it or ignore it.
    pub mut val hasErr: Bool = false
    pub mut val errOff: U64 = 0
    pub mut val errMsg: String = ""
}

// Does the current token match keyword text `kw` (an Ident like `pub`/`export`/
// `get`/`where`)? `export`/`pub`/`where` are contextual identifiers, not Kinds.
fn curIs(p: inout P, kw: String) -> Bool {
    match p.curKind() {
        Kind.Ident => {
            val t: Tok = p.curTok()
            return rangeEquals(bytes: p.bytes, start: t.start, len: t.len, kw: kw)
        }
        _ => { return false }
    }
}

// Skip a balanced `[ ... ]` group (current token must be the opening `[`).
fn skipBracketGroup(p: inout P) {
    mut val depth: I64 = 0
    while true {
        match p.curKind() {
            Kind.LBracket => {
                depth += 1
                p.advance()
            }
            Kind.RBracket => {
                depth -= 1
                p.advance()
                if depth == 0 {
                    break
                }
            }
            Kind.Eof => { break }
            _ => { p.advance() }
        }
    }
}

// Skip leading newlines, the `@[...]` directive(s), and an `export` modifier, so
// the cursor lands on the item keyword (`struct`/`enum`/`fn`/`unique`).
fn skipLeading(p: inout P) {
    while true {
        match p.curKind() {
            Kind.Newline => { p.advance() }
            Kind.Unknown => {
                // a directive: `@` lexes as Unknown; skip it and its `[...]`.
                p.advance()
                match p.curKind() {
                    Kind.LBracket => { skipBracketGroup(p: inout p) }
                    _ => {}
                }
            }
            Kind.Ident => {
                if curIs(p: inout p, kw: "export") {
                    p.advance()
                } else {
                    break
                }
            }
            _ => { break }
        }
    }
}

// A type expression `Name` or `Name[Arg, ...]`. Mirrors parseTypeTok's nominal
// path; a function type `fn(label: T, ...) -> R` is modeled as name="fn" with
// args = [R, T1, T2, ...] (labels/`inout` dropped — they aren't part of the C
// calling convention), mirroring the compiler's parseTypeTok. The current token is
// the type head.
fn parseType(p: inout P) -> TypeAst {
    // an existential `any P` (spec/08): the lowercase `any` (never a type name —
    // types are PascalCase) followed by a trait type. Parse the trait type and tag
    // it `isAny`. Unambiguous because `any` cannot head a real type.
    if curIs(p: inout p, kw: "any") {
        if p.peekKind(off: 1) == <Kind.Ident /> || p.peekKind(off: 1) == <Kind.KwSendable /> {
            val anyStart: U64 = p.base + p.curTok().start
            p.advance()
            mut val isSendableAny: Bool = false
            match p.curKind() {
                Kind.KwSendable => {
                    p.advance()
                    isSendableAny = true
                    match p.curKind() {
                        Kind.Ident => {}
                        _ => {
                            p.fail(off: p.base + p.curTok().start, msg: "`any sendable` must be followed by a trait type")
                            return emptyTypeAst()
                        }
                    }
                }
                _ => {}
            }
            val inner: TypeAst = parseType(p: inout p)
            return <TypeAst name=inner.name nameSpan=inner.nameSpan args=inner.args span=<Span start=anyStart end=p.prevEnd() /> extView=inner.extView extViewSpan=inner.extViewSpan viewNames=inner.viewNames viewNameSpans=inner.viewNameSpans projectionTrait=inner.projectionTrait projectionTraitSpan=inner.projectionTraitSpan projectionTraitArgs=inner.projectionTraitArgs projectionTraitArgLabels=inner.projectionTraitArgLabels projectionTraitArgLabelSpans=inner.projectionTraitArgLabelSpans projectionAssoc=inner.projectionAssoc projectionAssocSpan=inner.projectionAssocSpan isAny=true argLabels=inner.argLabels argLabelSpans=inner.argLabelSpans isSendable=isSendableAny isRecord=inner.isRecord />
        }
    }
    mut val isSendableFn: Bool = false
    mut val sendableStart: U64 = 0
    match p.curKind() {
        Kind.KwSendable => {
            if p.peekKind(off: 1) == <Kind.KwFn /> {
                sendableStart = p.base + p.curTok().start
                p.advance()
                isSendableFn = true
            } else {
                p.fail(off: p.base + p.curTok().start, msg: "`sendable` in type syntax is only valid before `fn` or after `any`")
                p.advance()
                return emptyTypeAst()
            }
        }
        _ => {}
    }
    // a labelled anonymous record type `(x: I32, y: I32)` / unit `()` (spec/02): a
    // structural record. Fields are `label: Type` pairs; `name` stays empty and the
    // field names/types ride in argLabels/args (isRecord marks it).
    match p.curKind() {
        Kind.LParen => {
            val recStart: U64 = p.base + p.curTok().start
            p.advance()
            mut val fieldTypes: Array[TypeAst] = []
            mut val fieldNames: Array[String] = []
            mut val fieldNameSpans: Array[Span] = []
            while true {
                match p.curKind() {
                    Kind.RParen => { p.advance()  break }
                    Kind.Eof => { break }
                    Kind.Comma => { p.advance() }
                    _ => {
                        val labelTok: Tok = p.curTok()
                        val label: String = p.text(t: labelTok)
                        p.advance()
                        match p.curKind() {
                            Kind.Colon => { p.advance() }
                            _ => { p.fail(off: p.base + p.curTok().start, msg: "an anonymous record field needs a `label: Type` (every field is labelled)") }
                        }
                        fieldNames.append(label)
                        fieldNameSpans.append(p.spanOf(t: labelTok))
                        fieldTypes.append(parseType(p: inout p))
                    }
                }
            }
            return <TypeAst name="" args=fieldTypes span=<Span start=recStart end=p.prevEnd() /> argLabels=fieldNames argLabelSpans=fieldNameSpans isRecord=true />
        }
        _ => {}
    }
    val head: Tok = p.curTok()
    match head.kind {
        Kind.Ident => {}
        Kind.KwFn => {}
        _ => {
            p.fail(off: p.base + head.start, msg: "expected a type name")
            p.advance()
            return emptyTypeAst()
        }
    }
    val name: String = p.text(t: head)
    val nameSpan: Span = p.spanOf(t: head)
    mut val sStart: U64 = p.base + head.start
    if isSendableFn {
        sStart = sendableStart
    }
    p.advance()
    match head.kind {
        Kind.KwFn => {
            mut val fparams: Array[TypeAst] = []
            // parameter labels (spec/04: labels are part of a function type's identity);
            // "" for an unlabeled position. Captured parallel to fparams.
            mut val flabels: Array[String] = []
            mut val flabelSpans: Array[Span] = []
            match p.curKind() {
                Kind.LParen => { p.advance() }
                _ => {}
            }
            while true {
                match p.curKind() {
                    Kind.RParen => {
                        p.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { p.advance() }
                    _ => {
                        // optional `label:` (or `label~:`) before the type.
                        mut val lbl: String = ""
                        mut val lblSpan: Span = <Span start=0 end=0 />
                        match p.curKind() {
                            Kind.Ident => {
                                if p.peekKind(off: 1) == <Kind.Colon /> {
                                    lbl = p.text(t: p.curTok())
                                    lblSpan = p.spanOf(t: p.curTok())
                                    p.advance()
                                    p.advance()
                                }
                            }
                            _ => {}
                        }
                        match p.curKind() {
                            Kind.KwInout => { p.advance() }
                            _ => {}
                        }
                        flabels.append(lbl)
                        flabelSpans.append(lblSpan)
                        fparams.append(parseType(p: inout p))
                    }
                }
            }
            mut val fret: TypeAst = emptyTypeAst()
            match p.curKind() {
                Kind.Arrow => {
                    p.advance()
                    fret = parseType(p: inout p)
                }
                _ => {}
            }
            mut val fargs: Array[TypeAst] = []
            fargs.append(fret)
            // argLabels parallel to fargs: slot 0 is the return type (no label, ""),
            // slots 1.. carry each parameter's label.
            mut val fargLabels: Array[String] = []
            mut val fargLabelSpans: Array[Span] = []
            fargLabels.append("")
            fargLabelSpans.append(<Span start=0 end=0 />)
            mut val fk: U64 = 0
            while fk < fparams.count() {
                fargs.append(fparams[fk])
                fargLabels.append(flabels[fk])
                fargLabelSpans.append(flabelSpans[fk])
                fk += 1
            }
            return <TypeAst name=name nameSpan=nameSpan args=fargs argLabels=fargLabels argLabelSpans=fargLabelSpans span=<Span start=sStart end=p.prevEnd() /> isSendable=isSendableFn />
        }
        _ => {}
    }
    mut val args: Array[TypeAst] = []
    // binding labels parallel to args: a named associated-type / type-parameter
    // binding `Name=Type` (spec/08,12 — used by `any P[Item=I32]`) records its name;
    // an ordinary positional type argument records "".
    mut val argLabels: Array[String] = []
    mut val argLabelSpans: Array[Span] = []
    match p.curKind() {
        Kind.LBracket => {
            p.advance()
            while true {
                match p.curKind() {
                    Kind.RBracket => {
                        p.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { p.advance() }
                    _ => {
                        // a named binding `Name = Type` (an Ident immediately followed
                        // by `=`): record the label and parse the bound type.
                        mut val lbl: String = ""
                        mut val lblSpan: Span = <Span start=0 end=0 />
                        match p.curKind() {
                            Kind.Ident => {
                                if p.peekKind(off: 1) == <Kind.Eq /> {
                                    lbl = p.text(t: p.curTok())
                                    lblSpan = p.spanOf(t: p.curTok())
                                    p.advance()
                                    p.advance()
                                }
                            }
                            _ => {}
                        }
                        args.append(parseType(p: inout p))
                        argLabels.append(lbl)
                        argLabelSpans.append(lblSpan)
                    }
                }
            }
        }
        _ => {}
    }
    // an extension-view refinement `Person#Ext` (spec/09), or an associated-type
    // projection `T#Trait.Item` / `T.Item` (spec/08). A `#Name` followed by `.Item`
    // is a projection source, not a value/extension view.
    mut val extView: String = ""
    mut val extViewSpan: Span = <Span start=0 end=0 />
    mut val viewNames: Array[String] = []
    mut val viewNameSpans: Array[Span] = []
    mut val projectionTrait: String = ""
    mut val projectionTraitSpan: Span = <Span start=0 end=0 />
    mut val projectionTraitArgs: Array[TypeAst] = []
    mut val projectionTraitArgLabels: Array[String] = []
    mut val projectionTraitArgLabelSpans: Array[Span] = []
    mut val projectionAssoc: String = ""
    mut val projectionAssocSpan: Span = <Span start=0 end=0 />
    mut val parsingViews: Bool = true
    while parsingViews {
        match p.curKind() {
        Kind.Hash => {
            p.advance()
            val hashNameTok: Tok = p.curTok()
            val hashName: String = p.text(t: hashNameTok)
            val hashNameSpan: Span = p.spanOf(t: hashNameTok)
            p.advance()
            match p.curKind() {
                Kind.LBracket => {
                    p.advance()
                    while true {
                        match p.curKind() {
                            Kind.RBracket => {
                                p.advance()
                                break
                            }
                            Kind.Eof => { break }
                            Kind.Comma => { p.advance() }
                            _ => {
                                mut val lbl: String = ""
                                mut val lblSpan: Span = <Span start=0 end=0 />
                                match p.curKind() {
                                    Kind.Ident => {
                                        if p.peekKind(off: 1) == <Kind.Eq /> {
                                            lbl = p.text(t: p.curTok())
                                            lblSpan = p.spanOf(t: p.curTok())
                                            p.advance()
                                            p.advance()
                                        }
                                    }
                                    _ => {}
                                }
                                projectionTraitArgs.append(parseType(p: inout p))
                                projectionTraitArgLabels.append(lbl)
                                projectionTraitArgLabelSpans.append(lblSpan)
                            }
                        }
                    }
                    match p.curKind() {
                        Kind.Dot => {
                            p.advance()
                            projectionTrait = hashName
                            projectionTraitSpan = hashNameSpan
                            val assocTok: Tok = p.curTok()
                            projectionAssoc = p.text(t: assocTok)
                            projectionAssocSpan = p.spanOf(t: assocTok)
                            p.advance()
                        }
                        _ => {}
                    }
                }
                Kind.Dot => {
                    p.advance()
                    projectionTrait = hashName
                    projectionTraitSpan = hashNameSpan
                    val assocTok: Tok = p.curTok()
                    projectionAssoc = p.text(t: assocTok)
                    projectionAssocSpan = p.spanOf(t: assocTok)
                    p.advance()
                }
                _ => {
                    extView = hashName
                    extViewSpan = hashNameSpan
                    viewNames.append(hashName)
                    viewNameSpans.append(hashNameSpan)
                }
            }
        }
        _ => { parsingViews = false }
        }
        if projectionAssoc.bytes().count() > 0 {
            parsingViews = false
        }
    }
    if projectionAssoc.bytes().count() == 0 {
        match p.curKind() {
            Kind.Dot => {
                p.advance()
                val assocTok: Tok = p.curTok()
                projectionAssoc = p.text(t: assocTok)
                projectionAssocSpan = p.spanOf(t: assocTok)
                p.advance()
            }
            _ => {}
        }
    }
    return <TypeAst name=name nameSpan=nameSpan args=args span=<Span start=sStart end=p.prevEnd() /> extView=extView extViewSpan=extViewSpan viewNames=viewNames viewNameSpans=viewNameSpans projectionTrait=projectionTrait projectionTraitSpan=projectionTraitSpan projectionTraitArgs=projectionTraitArgs projectionTraitArgLabels=projectionTraitArgLabels projectionTraitArgLabelSpans=projectionTraitArgLabelSpans projectionAssoc=projectionAssoc projectionAssocSpan=projectionAssocSpan argLabels=argLabels argLabelSpans=argLabelSpans />
}

// Parse a `newtype Name = Underlying` declaration (spec/10). The contextual `newtype`
// has already been confirmed by the caller; consume it, the name, `=`, and the type.
fn parseNewtypeAst(p: inout P, isPub: Bool) -> TopItemAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    p.advance()
    match p.curKind() {
        Kind.Eq => { p.advance() }
        _ => { p.fail(off: p.base + p.curTok().start, msg: "a newtype declaration is `newtype Name = Underlying`") }
    }
    val ty: TypeAst = parseType(p: inout p)
    return <TopItemAst.NewType name=name nameSpan=p.spanOf(t: nameTok) ty=ty isPub=isPub span=<Span start=sStart end=p.prevEnd() /> />
}

// An optional generic parameter list `[T, sendable U]` -> names plus per-parameter
// sendability requirements. Old ambient markers are not recognized; `sendable` is
// a keyword and is the only accepted marker in this position.
fn parseTypeParamList(p: inout P) -> TypeParamListAst {
    mut val ps: Array[String] = []
    mut val flags: Array[Bool] = []
    mut val nameSpans: Array[Span] = []
    match p.curKind() {
        Kind.LBracket => {
            p.advance()
            while true {
                match p.curKind() {
                    Kind.RBracket => {
                        p.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { p.advance() }
                    Kind.Colon => {
                        // inline trait constraint `[T: Trait]` (spec/06: not allowed —
                        // constraints go in a `where` clause). Reject loudly.
                        p.fail(off: p.base + p.curTok().start, msg: "inline trait constraint is not allowed in `[...]`; use a `where` clause")
                        p.advance()
                    }
                    Kind.KwSendable => {
                        p.advance()
                        match p.curKind() {
                            Kind.Ident => {
                                val nameTok: Tok = p.curTok()
                                ps.append(p.text(t: nameTok))
                                flags.append(true)
                                nameSpans.append(p.spanOf(t: nameTok))
                                p.advance()
                                match p.curKind() {
                                    Kind.Ident => { p.fail(off: p.base + p.curTok().start, msg: "expected `,` or `]` after generic parameter name") }
                                    Kind.KwSendable => { p.fail(off: p.base + p.curTok().start, msg: "expected `,` or `]` after generic parameter name") }
                                    _ => {}
                                }
                            }
                            _ => {
                                p.fail(off: p.base + p.curTok().start, msg: "`sendable` in a generic parameter list must be followed by a parameter name")
                            }
                        }
                    }
                    Kind.Ident => {
                        val nameTok: Tok = p.curTok()
                        val name: String = p.text(t: nameTok)
                        p.advance()
                        ps.append(name)
                        flags.append(false)
                        nameSpans.append(p.spanOf(t: nameTok))
                        match p.curKind() {
                            Kind.Ident => { p.fail(off: p.base + p.curTok().start, msg: "expected `,` or `]` after generic parameter name") }
                            Kind.KwSendable => { p.fail(off: p.base + p.curTok().start, msg: "expected `,` or `]` after generic parameter name") }
                            _ => {}
                        }
                    }
                    _ => {
                        p.fail(off: p.base + p.curTok().start, msg: "unexpected token in generic parameter list; expected a parameter name or `sendable Name`")
                        p.advance()
                    }
                }
            }
        }
        _ => {}
    }
    return <TypeParamListAst names=ps isSendable=flags nameSpans=nameSpans />
}

fn parseTypeParamNames(p: inout P) -> Array[String] {
    return parseTypeParamList(p: inout p).names
}

// A struct field: `[pub[(get)]] [mut] val name [: Type] [= expr]`. The cursor is
// at the field start (caller has skipped newlines and ruled out `}`/`deinit`).
fn parseStructField(p: inout P) -> FieldAst {
    val fStart: U64 = p.base + p.curTok().start
    mut val vis: U64 = 0
    mut val usedPubGet: Bool = false
    if curIs(p: inout p, kw: "pub") {
        p.advance()
        vis = 2
        match p.curKind() {
            Kind.LParen => {
                p.advance()
                if !(curIs(p: inout p, kw: "get")) {
                    p.fail(off: p.base + p.curTok().start, msg: "field visibility is `pub` or `pub(get)`; no other `pub(...)` form exists")
                }
                vis = 1
                usedPubGet = true
                p.advance()
                match p.curKind() {
                    Kind.RParen => { p.advance() }
                    _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `)` after `pub(get)`") }
                }
            }
            _ => {}
        }
    }
    mut val isMut: Bool = false
    match p.curKind() {
        Kind.KwMut => {
            p.advance()
            isMut = true
        }
        _ => {}
    }
    match p.curKind() {
        Kind.KwVal => { p.advance() }
        _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `val` in struct field declaration") }
    }
    if usedPubGet && !isMut {
        p.fail(off: fStart, msg: "`pub(get)` is only valid on `mut val`; use `pub val` for a public read-only field")
    }
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    p.advance()
    mut val ty: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Colon => {
            p.advance()
            ty = parseType(p: inout p)
        }
        _ => {}
    }
    mut val hasDefault: Bool = false
    mut val defaultVal: ExprAst = emptyExpr()
    match p.curKind() {
        Kind.Eq => {
            p.advance()
            defaultVal = parseExprAst(p: inout p)
            hasDefault = true
        }
        _ => {}
    }
    if ty.span.end == ty.span.start && !hasDefault {
        p.fail(off: fStart, msg: "struct field needs a type annotation or a default value")
    }
    return <FieldAst name=name nameSpan=p.spanOf(t: nameTok) ty=ty isMut=isMut vis=vis hasDefault=hasDefault defaultVal=defaultVal span=<Span start=fStart end=p.prevEnd() /> />
}

// A struct declaration. The cursor is at `struct` (modifiers before it are already
// consumed and passed in).
export fn parseStructDecl(p: inout P, isUnique: Bool, isNonsendable: Bool = false) -> DeclAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => {}
    }
    mut val fields: Array[FieldAst] = []
    mut val hasDeinit: Bool = false
    mut val deinitBody: BlockAst = emptyBlock()
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Comma => {
                // struct fields are newline-separated (spec/05); a comma would be
                // swallowed as an empty-named field, so reject it loudly.
                p.fail(off: p.base + p.curTok().start, msg: "struct fields are separated by newlines, not commas")
                p.advance()
            }
            Kind.KwDeinit => {
                p.advance()
                p.skipNewlines()
                deinitBody = parseBlockAst(p: inout p)
                hasDeinit = true
            }
            _ => {
                // struct fields are newline-separated (spec/05); a `;` would be
                // parsed as an empty-named phantom field, so reject it loudly (like a
                // comma) instead of silently widening the struct.
                if p.text(t: p.curTok()) == ";" {
                    p.fail(off: p.base + p.curTok().start, msg: "struct fields are separated by newlines, not `;`")
                    p.advance()
                } else {
                    fields.append(parseStructField(p: inout p))
                }
            }
        }
    }
    return <DeclAst kind=<DeclKind.Struct /> name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable span=<Span start=sStart end=p.prevEnd() /> isUnique=isUnique isNonsendable=isNonsendable fields=fields hasDeinit=hasDeinit deinitBody=deinitBody variants=[] params=[] hasRet=false ret=emptyTypeAst() isAsync=false whereParams=[] whereTraits=[] body=emptyBlock() />
}

// An enum variant payload field `name: Type` (no modifiers). The cursor is at the
// field name.
fn parseVariantField(p: inout P) -> FieldAst {
    val fStart: U64 = p.base + p.curTok().start
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    p.advance()
    mut val ty: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Colon => {
            p.advance()
            ty = parseType(p: inout p)
        }
        _ => {}
    }
    return <FieldAst name=name nameSpan=p.spanOf(t: nameTok) ty=ty isMut=false vis=0 hasDefault=false defaultVal=emptyExpr() span=<Span start=fStart end=p.prevEnd() /> />
}

// An enum declaration. The cursor is at `enum`.
export fn parseEnumDecl(p: inout P, isUnique: Bool, isNonsendable: Bool = false) -> DeclAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => {}
    }
    mut val variants: Array[VariantAst] = []
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Hash => {
                p.fail(off: p.base + p.curTok().start, msg: "unexpected `#` in enum body")
                p.advance()
            }
            Kind.Ident => {
                val vTok: Tok = p.curTok()
                val vName: String = p.text(t: vTok)
                val vStart: U64 = p.base + vTok.start
                p.advance()
                mut val vfields: Array[FieldAst] = []
                match p.curKind() {
                    Kind.LBrace => {
                        // variant payloads are record-form `V(x: I32, ...)` (spec/05):
                        // the brace form is rejected with a hint (acceptance soundness).
                        p.fail(off: p.base + p.curTok().start, msg: "enum variant payloads use parentheses, e.g. `Foo(x: I32, y: I32)`")
                    }
                    Kind.LParen => {
                        p.advance()
                        while true {
                            p.skipNewlines()
                            match p.curKind() {
                                Kind.RParen => {
                                    p.advance()
                                    break
                                }
                                Kind.Eof => { break }
                                Kind.Ident => {
                                    vfields.append(parseVariantField(p: inout p))
                                    match p.curKind() {
                                        Kind.Comma => { p.advance() }
                                        _ => {}
                                    }
                                }
                                _ => { p.advance() }
                            }
                        }
                    }
                    _ => {}
                }
                variants.append(<VariantAst name=vName nameSpan=p.spanOf(t: vTok) fields=vfields span=<Span start=vStart end=p.prevEnd() /> />)
            }
            _ => { p.advance() }
        }
    }
    return <DeclAst kind=<DeclKind.Enum /> name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable span=<Span start=sStart end=p.prevEnd() /> isUnique=isUnique isNonsendable=isNonsendable fields=[] hasDeinit=false deinitBody=emptyBlock() variants=variants params=[] hasRet=false ret=emptyTypeAst() isAsync=false whereParams=[] whereTraits=[] body=emptyBlock() />
}

// A function parameter `name[~]: [inout|move|borrow] Type [= expr]`. The cursor is
// at the parameter name.
fn parseParamAst(p: inout P) -> ParamAst {
    val pStart: U64 = p.base + p.curTok().start
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    p.advance()
    mut val noLabel: Bool = false
    match p.curKind() {
        Kind.Tilde => {
            if p.peekKind(off: 1) == <Kind.Colon /> {
                p.advance()
                noLabel = true
            }
        }
        _ => {}
    }
    mut val ty: TypeAst = emptyTypeAst()
    mut val isInout: Bool = false
    mut val isMove: Bool = false
    mut val isBorrow: Bool = false
    match p.curKind() {
        Kind.Colon => {
            p.advance()
            match p.curKind() {
                Kind.KwInout => {
                    p.advance()
                    isInout = true
                }
                Kind.KwMove => {
                    p.advance()
                    isMove = true
                }
                Kind.KwBorrow => {
                    p.advance()
                    isBorrow = true
                }
                _ => {}
            }
            ty = parseType(p: inout p)
        }
        _ => {}
    }
    mut val hasDefault: Bool = false
    mut val defaultVal: ExprAst = emptyExpr()
    match p.curKind() {
        Kind.Eq => {
            p.advance()
            defaultVal = parseExprAst(p: inout p)
            hasDefault = true
        }
        _ => {}
    }
    return <ParamAst name=name nameSpan=p.spanOf(t: nameTok) ty=ty isInout=isInout isMove=isMove isBorrow=isBorrow noLabel=noLabel hasDefault=hasDefault defaultVal=defaultVal span=<Span start=pStart end=p.prevEnd() /> />
}

// A parenthesized parameter list `( params )`. The cursor is at `(` (or anything
// else for a zero-arg fn with no list).
fn parseParamAsts(p: inout P) -> Array[ParamAst] {
    mut val params: Array[ParamAst] = []
    match p.curKind() {
        Kind.LParen => {
            p.advance()
            while true {
                p.skipNewlines()
                match p.curKind() {
                    Kind.RParen => {
                        p.advance()
                        break
                    }
                    Kind.Eof => {
                        // `fn main( {` — an unclosed parameter list swallowed the rest
                        // of the file and was silently accepted.
                        p.fail(off: p.base + p.curTok().start, msg: "expected `)` to close the parameter list before the end of input")
                        break
                    }
                    Kind.Comma => { p.advance() }
                    _ => {
                        params.append(parseParamAst(p: inout p))
                    }
                }
            }
        }
        _ => {}
    }
    return params
}

// A `where T: A + B, U: C` trait-bound clause (spec/08) into parallel name lists
// (one (param, trait) pair per `+`/`,` atom). Appends into `params`/`traits`. The
// cursor may or may not be at `where`; a non-`where` token leaves both untouched.
// Mirrors the compiler's parseWhereClause.
fn parseWhereNames(p: inout P, params: inout Array[String], traits: inout Array[String], types: inout Array[TypeAst], traitTypes: inout Array[TypeAst]) {
    if curIs(p: inout p, kw: "where") {
        p.advance()
        mut val cont: Bool = true
        while cont {
            p.skipNewlines()
            match p.curKind() {
                Kind.Ident => {
                    val lhs: TypeAst = parseType(p: inout p)
                    match p.curKind() {
                        Kind.Colon => { p.advance() }
                        _ => {}
                    }
                    mut val moreTraits: Bool = true
                    while moreTraits {
                        match p.curKind() {
                            Kind.Ident => {
                                val tName: TypeAst = parseType(p: inout p)
                                params.append(lhs.name)
                                traits.append(tName.name)
                                types.append(lhs)
                                traitTypes.append(tName)
                            }
                            _ => {}
                        }
                        match p.curKind() {
                            Kind.Plus => { p.advance() }
                            _ => { moreTraits = false }
                        }
                    }
                    match p.curKind() {
                        Kind.Comma => { p.advance() }
                        _ => { cont = false }
                    }
                }
                _ => { cont = false }
            }
        }
    }
}

// A function declaration `fn name[T,...](params) [-> Ret] [where ...] { body }`.
// The cursor is at `fn` (a leading `async`, if any, is already consumed and passed
// as `isAsync`). The body is parsed; the where-bounds are captured.
export fn parseFuncDecl(p: inout P, isAsync: Bool) -> DeclAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    val params: Array[ParamAst] = parseParamAsts(p: inout p)
    mut val hasRet: Bool = false
    mut val ret: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Arrow => {
            p.advance()
            ret = parseType(p: inout p)
            hasRet = true
        }
        _ => {}
    }
    mut val whereParams: Array[String] = []
    mut val whereTraits: Array[String] = []
    mut val whereTypes: Array[TypeAst] = []
    mut val whereTraitTypes: Array[TypeAst] = []
    parseWhereNames(p: inout p, params: inout whereParams, traits: inout whereTraits, types: inout whereTypes, traitTypes: inout whereTraitTypes)
    p.skipNewlines()
    val body: BlockAst = parseBlockAst(p: inout p)
    return <DeclAst kind=<DeclKind.Func /> name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable span=<Span start=sStart end=p.prevEnd() /> isUnique=false fields=[] hasDeinit=false deinitBody=emptyBlock() variants=[] params=params hasRet=hasRet ret=ret isAsync=isAsync whereParams=whereParams whereTraits=whereTraits whereTypes=whereTypes whereTraitTypes=whereTraitTypes body=body />
}

// Parse an item's source into a `DeclAst` (struct / enum / fn). `source` is the
// item's own text (the declaration through its closing `}`); `start` is that
// text's absolute offset in the original file, used as the base so every emitted
// `Span` is in ORIGINAL coordinates (an input error points at the user's text);
// `end` (= start + source length) is informational. An item the M1 subset doesn't
// model yet yields an empty struct decl (logged: traits/impls/newtypes additive).
export fn parseItem(source: String, start: U64, end: U64) -> TopItemAst {
    val sb: Array[U8] = source.bytes()
    mut val lx: Lexer = <Lexer bytes=sb pos=0 toks=[] depth=0 />
    lex(lx: inout lx)
    mut val p: P = <P bytes=sb toks=lx.toks pos=0 base=start />
    skipLeading(p: inout p)
    // dispatch the one annotated item, mirroring parseProgramAst (a macro target is
    // a struct / enum / fn / impl / trait / extern). The result is the `TopItemAst`
    // the macro's `derive` matches on.
    match p.curKind() {
        Kind.KwStruct => { return <TopItemAst.Decl d=parseStructDecl(p: inout p, isUnique: false) /> }
        Kind.KwNonsendable => {
            p.advance()
            match p.curKind() {
                Kind.KwStruct => { return <TopItemAst.Decl d=parseStructDecl(p: inout p, isUnique: false, isNonsendable: true) /> }
                Kind.KwEnum => { return <TopItemAst.Decl d=parseEnumDecl(p: inout p, isUnique: false, isNonsendable: true) /> }
                _ => {
                    p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `nonsendable`")
                    return emptyTopItem(off: p.base + p.curTok().start)
                }
            }
        }
        Kind.KwUnique => {
            // `unique` prefixes a nominal type declaration: struct or enum (spec/03) —
            // dispatch on the following keyword instead of assuming struct (an
            // assumed-struct parse silently swallowed `unique enum` as a junk struct).
            p.advance()
            match p.curKind() {
                Kind.KwNonsendable => {
                    p.advance()
                    match p.curKind() {
                        Kind.KwStruct => { return <TopItemAst.Decl d=parseStructDecl(p: inout p, isUnique: true, isNonsendable: true) /> }
                        Kind.KwEnum => { return <TopItemAst.Decl d=parseEnumDecl(p: inout p, isUnique: true, isNonsendable: true) /> }
                        _ => {
                            p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `unique nonsendable`")
                            return emptyTopItem(off: p.base + p.curTok().start)
                        }
                    }
                }
                Kind.KwStruct => { return <TopItemAst.Decl d=parseStructDecl(p: inout p, isUnique: true) /> }
                Kind.KwEnum => { return <TopItemAst.Decl d=parseEnumDecl(p: inout p, isUnique: true) /> }
                _ => {
                    p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `unique`")
                    return emptyTopItem(off: p.base + p.curTok().start)
                }
            }
        }
        Kind.KwEnum => { return <TopItemAst.Decl d=parseEnumDecl(p: inout p, isUnique: false) /> }
        Kind.KwFn => { return <TopItemAst.Decl d=parseFuncDecl(p: inout p, isAsync: false) /> }
        Kind.KwSpawn => {
            p.fail(off: p.base + p.curTok().start, msg: "`spawn fn` is rejected in v1 until spawn-boundary sendability/effect checking is available")
            return emptyTopItem(off: p.base + p.curTok().start)
        }
        Kind.KwAsync => {
            p.advance()
            return <TopItemAst.Decl d=parseFuncDecl(p: inout p, isAsync: true) />
        }
        Kind.KwExtern => { return <TopItemAst.Extern e=parseExternDecl(p: inout p) /> }
        Kind.Ident => {
            if curIs(p: inout p, kw: "trait") {
                return <TopItemAst.Trait t=parseTraitDecl(p: inout p) />
            }
            if curIs(p: inout p, kw: "pub") {
                p.advance()
                if curIs(p: inout p, kw: "impl") {
                    return <TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: true) />
                }
                return emptyTopItem(off: p.base + p.curTok().start)
            }
            if curIs(p: inout p, kw: "impl") {
                return <TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: false) />
            }
            return emptyTopItem(off: p.base + p.curTok().start)
        }
        _ => { return emptyTopItem(off: start) }
    }
}

// A placeholder `TopItemAst` for an item the parser does not recognize (a macro on
// an unsupported target). An empty struct declaration so `.derive` can match `Decl`
// and fall through.
fn emptyTopItem(off: U64) -> TopItemAst {
    return <TopItemAst.Decl d=emptyDeclAst(off: off) />
}

fn emptyDeclAst(off: U64) -> DeclAst {
    return <DeclAst kind=<DeclKind.Struct /> name="" nameSpan=<Span start=off end=off /> typeParams=[] span=<Span start=off end=off /> isUnique=false fields=[] hasDeinit=false deinitBody=emptyBlock() variants=[] params=[] hasRet=false ret=emptyTypeAst() isAsync=false whereParams=[] whereTraits=[] body=emptyBlock() />
}

// Parse a single nominal declaration (`[unique] struct` / `enum` / `fn`) from the
// compiler's own token stream — the cursor is already at the item keyword (the
// frontend's `parseProgram` dispatched). Mirrors `parseItem`'s match without the
// re-lex/skipLeading. The frontend drives this over its `P` (base 0 = absolute
// c.bytes offsets) and lowers the result into its arena (Codegen/Lower.pw).
export fn parseDecl(p: inout P) -> DeclAst {
    match p.curKind() {
        Kind.KwStruct => { return parseStructDecl(p: inout p, isUnique: false) }
        Kind.KwNonsendable => {
            p.advance()
            match p.curKind() {
                Kind.KwStruct => { return parseStructDecl(p: inout p, isUnique: false, isNonsendable: true) }
                Kind.KwEnum => { return parseEnumDecl(p: inout p, isUnique: false, isNonsendable: true) }
                _ => {
                    p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `nonsendable`")
                    return emptyDeclAst(off: p.base + p.curTok().start)
                }
            }
        }
        Kind.KwUnique => {
            // `unique struct` / `unique enum` (spec/03): dispatch on the following
            // keyword — assuming struct silently swallowed `unique enum` as junk.
            p.advance()
            match p.curKind() {
                Kind.KwNonsendable => {
                    p.advance()
                    match p.curKind() {
                        Kind.KwStruct => { return parseStructDecl(p: inout p, isUnique: true, isNonsendable: true) }
                        Kind.KwEnum => { return parseEnumDecl(p: inout p, isUnique: true, isNonsendable: true) }
                        _ => {
                            p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `unique nonsendable`")
                            return emptyDeclAst(off: p.base + p.curTok().start)
                        }
                    }
                }
                Kind.KwStruct => { return parseStructDecl(p: inout p, isUnique: true) }
                Kind.KwEnum => { return parseEnumDecl(p: inout p, isUnique: true) }
                _ => {
                    p.fail(off: p.base + p.curTok().start, msg: "expected `struct` or `enum` after `unique`")
                    return emptyDeclAst(off: p.base + p.curTok().start)
                }
            }
        }
        Kind.KwEnum => { return parseEnumDecl(p: inout p, isUnique: false) }
        Kind.KwFn => { return parseFuncDecl(p: inout p, isAsync: false) }
        Kind.KwSpawn => {
            p.fail(off: p.base + p.curTok().start, msg: "`spawn fn` is rejected in v1 until spawn-boundary sendability/effect checking is available")
            p.advance()
            match p.curKind() {
                Kind.KwFn => { return parseFuncDecl(p: inout p, isAsync: false) }
                _ => { return emptyDeclAst(off: p.base + p.curTok().start) }
            }
        }
        Kind.KwAsync => {
            p.advance()
            return parseFuncDecl(p: inout p, isAsync: true)
        }
        _ => {
            val off: U64 = p.base + p.curTok().start
            return emptyDeclAst(off: off)
        }
    }
}

// Parse `assoc val NAME: T = expr` (cursor at `val`) and synthesize a zero-arg
// `assoc fn NAME() -> T { return expr }` MemberAst (spec/05). The constant rides the
// existing assoc-fn path; `Type.NAME` resolves to a call.
fn parseAssocValMember(p: inout P) -> MemberAst {
    val vStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    mut val ty: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Colon => {
            p.advance()
            ty = parseType(p: inout p)
        }
        _ => {}
    }
    match p.curKind() {
        Kind.Eq => { p.advance() }
        _ => {}
    }
    val init: ExprAst = parseExprAst(p: inout p)
    mut val stmts: Array[StmtAst] = []
    stmts.append(<StmtAst.Return value=init hasValue=true span=<Span start=vStart end=p.prevEnd() /> />)
    val body: BlockAst = <BlockAst stmts=stmts />
    return <MemberAst kind=<MemberKind.AssocFn /> name=name nameSpan=nameSpan typeParams=[] params=[] hasRet=true ret=ty whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=body assocTy=emptyTypeAst() />
}

// Parse a method/assoc-fn member after its mode keyword(s) and `fn` are consumed
// (cursor at the method name): `name[T,...](params) [-> Ret] [where ...]
// (via real | { body })`. `kind`/`selfInout`/`selfMove`/`isAsync` come from the
// mode keyword the caller already consumed.
fn parseMethodAfterFn(p: inout P, kind: MemberKind, selfInout: Bool, selfMove: Bool, isAsync: Bool) -> MemberAst {
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    val params: Array[ParamAst] = parseParamAsts(p: inout p)
    mut val hasRet: Bool = false
    mut val ret: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Arrow => {
            p.advance()
            ret = parseType(p: inout p)
            hasRet = true
        }
        _ => {}
    }
    mut val whereParams: Array[String] = []
    mut val whereTraits: Array[String] = []
    mut val whereTypes: Array[TypeAst] = []
    mut val whereTraitTypes: Array[TypeAst] = []
    parseWhereNames(p: inout p, params: inout whereParams, traits: inout whereTraits, types: inout whereTypes, traitTypes: inout whereTraitTypes)
    // `via real`: witnesses a requirement by aliasing an existing method (no body).
    mut val isVia: Bool = false
    mut val viaName: String = ""
    mut val viaNameSpan: Span = <Span start=0 end=0 />
    if curIs(p: inout p, kw: "via") {
        p.advance()
        val viaTok: Tok = p.curTok()
        viaName = p.text(t: viaTok)
        viaNameSpan = p.spanOf(t: viaTok)
        p.advance()
        isVia = true
    }
    mut val body: BlockAst = emptyBlock()
    if !(isVia) {
        p.skipNewlines()
        body = parseBlockAst(p: inout p)
    }
    return <MemberAst kind=kind name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable params=params hasRet=hasRet ret=ret whereParams=whereParams whereTraits=whereTraits whereTypes=whereTypes whereTraitTypes=whereTraitTypes isAsync=isAsync selfInout=selfInout selfMove=selfMove isVia=isVia viaName=viaName viaNameSpan=viaNameSpan body=body assocTy=emptyTypeAst() />
}

// An `[pub] impl[T] Recv [as Trait] [where ...] { members }` block (spec/07,08).
// The cursor is at the `impl` ident (the leading `pub`, if any, is already consumed
// and passed as `isPub`). Mirrors the compiler's parseImpl.
export fn parseImplDecl(p: inout P, isPub: Bool, extName: String = "", extNameSpan: Span = <Span start=0 end=0 />) -> ImplAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val implTps: TypeParamListAst = parseTypeParamList(p: inout p)
    val recvType: TypeAst = parseType(p: inout p)
    mut val isTraitImpl: Bool = false
    mut val traitName: String = ""
    mut val traitNameSpan: Span = <Span start=0 end=0 />
    mut val traitArgs: Array[TypeAst] = []
    match p.curKind() {
        Kind.KwAs => {
            p.advance()
            val traitTok: Tok = p.curTok()
            traitName = p.text(t: traitTok)
            traitNameSpan = p.spanOf(t: traitTok)
            p.advance()
            isTraitImpl = true
            // trait type arguments `as Add[V]` (spec/12): bind the trait's type
            // parameters. Comma-separated full types until `]`.
            match p.curKind() {
                Kind.LBracket => {
                    p.advance()
                    while true {
                        match p.curKind() {
                            Kind.RBracket => {
                                p.advance()
                                break
                            }
                            Kind.Eof => { break }
                            Kind.Comma => { p.advance() }
                            _ => { traitArgs.append(parseType(p: inout p)) }
                        }
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    mut val whereParams: Array[String] = []
    mut val whereTraits: Array[String] = []
    mut val whereTypes: Array[TypeAst] = []
    mut val whereTraitTypes: Array[TypeAst] = []
    parseWhereNames(p: inout p, params: inout whereParams, traits: inout whereTraits, types: inout whereTypes, traitTypes: inout whereTraitTypes)
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => {}
    }
    mut val members: Array[MemberAst] = []
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwInout => {
                p.advance()
                match p.curKind() {
                    Kind.KwFn => { p.advance() }
                    _ => {}
                }
                members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.Method />, selfInout: true, selfMove: false, isAsync: false))
            }
            Kind.KwFn => {
                p.advance()
                members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.Method />, selfInout: false, selfMove: false, isAsync: false))
            }
            Kind.KwAsync => {
                p.advance()
                mut val asyncMove: Bool = false
                match p.curKind() {
                    Kind.KwMove => {
                        p.advance()
                        asyncMove = true
                    }
                    _ => {}
                }
                match p.curKind() {
                    Kind.KwFn => { p.advance() }
                    _ => {}
                }
                members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.Method />, selfInout: false, selfMove: asyncMove, isAsync: true))
            }
            Kind.KwMove => {
                p.advance()
                match p.curKind() {
                    Kind.KwFn => { p.advance() }
                    _ => {}
                }
                members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.Method />, selfInout: false, selfMove: true, isAsync: false))
            }
            Kind.KwBorrow => {
                p.advance()
                match p.curKind() {
                    Kind.KwFn => { p.advance() }
                    _ => {}
                }
                members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.Method />, selfInout: false, selfMove: false, isAsync: false))
            }
            Kind.KwDeinit => {
                val dStart: U64 = p.base + p.curTok().start
                p.advance()
                p.skipNewlines()
                val dbody: BlockAst = parseBlockAst(p: inout p)
                members.append(<MemberAst kind=<MemberKind.Deinit /> name="" nameSpan=<Span start=dStart end=dStart /> typeParams=[] params=[] hasRet=false ret=emptyTypeAst() whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=dbody assocTy=emptyTypeAst() />)
            }
            _ => {
                if curIs(p: inout p, kw: "factory") || curIs(p: inout p, kw: "optional") || curIs(p: inout p, kw: "result") {
                    // `factory` (spec/05): a bare `factory` publishes the default
                    // memberwise factory (the span feeds the publication gate). A
                    // `factory name(params) { … }` is a custom NAMED factory, lowered as
                    // an AssocFn returning Self and invoked via `<Type.name …/>`. A
                    // leading `optional` / `result[E]` makes it fallible (→ Optional[Self]
                    // / Result[Self, E]).
                    mut val facKind: U64 = 0
                    mut val facErr: TypeAst = emptyTypeAst()
                    if curIs(p: inout p, kw: "optional") {
                        p.advance()
                        facKind = 1U64
                    } else {
                        if curIs(p: inout p, kw: "result") {
                            p.advance()
                            match p.curKind() {
                                Kind.LBracket => {
                                    p.advance()
                                    facErr = parseType(p: inout p)
                                    match p.curKind() {
                                        Kind.RBracket => { p.advance() }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                            facKind = 2U64
                        }
                    }
                    val fTok: Tok = p.curTok()
                    val fSpan: Span = p.spanOf(t: fTok)
                    p.advance()
                    match p.curKind() {
                        Kind.Ident => {
                            val nameTok: Tok = p.curTok()
                            val fname: String = p.text(t: nameTok)
                            val fnameSpan: Span = p.spanOf(t: nameTok)
                            p.advance()
                            val fparams: Array[ParamAst] = parseParamAsts(p: inout p)
                            val fbody: BlockAst = parseBlockAst(p: inout p)
                            members.append(<MemberAst kind=<MemberKind.AssocFn /> name=fname nameSpan=fnameSpan typeParams=[] params=fparams hasRet=false ret=emptyTypeAst() whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=fbody assocTy=emptyTypeAst() isFactory=true factoryKind=facKind factoryErr=facErr />)
                        }
                        Kind.LParen => {
                            // anonymous factory `factory(label: T) { … }` (spec/05) — the
                            // `From` shape `factory(from: x)` → invoked via `<T from=x/>` /
                            // `x as T`. Named by its (single) parameter label so the
                            // construction can route by field label.
                            val fparams: Array[ParamAst] = parseParamAsts(p: inout p)
                            val fbody: BlockAst = parseBlockAst(p: inout p)
                            mut val anonName: String = ""
                            if fparams.count() > 0 {
                                anonName = fparams[0].name
                            }
                            members.append(<MemberAst kind=<MemberKind.AssocFn /> name=anonName nameSpan=fSpan typeParams=[] params=fparams hasRet=false ret=emptyTypeAst() whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=fbody assocTy=emptyTypeAst() isFactory=true factoryKind=facKind factoryErr=facErr />)
                        }
                        _ => {
                            members.append(<MemberAst kind=<MemberKind.Factory /> name="factory" nameSpan=fSpan typeParams=[] params=[] hasRet=false ret=emptyTypeAst() whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=emptyBlock() assocTy=emptyTypeAst() />)
                        }
                    }
                } else {
                if curIs(p: inout p, kw: "assoc") {
                    p.advance()
                    match p.curKind() {
                        Kind.KwVal => {
                            // `assoc val NAME: T = expr` (spec/05): a per-type constant.
                            // Desugar to a zero-arg `assoc fn NAME() -> T { return expr }`
                            // so it rides the existing assoc-fn machinery (`Type.NAME`).
                            members.append(parseAssocValMember(p: inout p))
                        }
                        _ => {
                            match p.curKind() {
                                Kind.KwFn => { p.advance() }
                                _ => {}
                            }
                            members.append(parseMethodAfterFn(p: inout p, kind: <MemberKind.AssocFn />, selfInout: false, selfMove: false, isAsync: false))
                        }
                    }
                } else {
                    if curIs(p: inout p, kw: "type") {
                        p.advance()
                        val atTok: Tok = p.curTok()
                        val atName: String = p.text(t: atTok)
                        val atSpan: Span = p.spanOf(t: atTok)
                        p.advance()
                        match p.curKind() {
                            Kind.Eq => { p.advance() }
                            _ => {}
                        }
                        val aty: TypeAst = parseType(p: inout p)
                        members.append(<MemberAst kind=<MemberKind.AssocType /> name=atName nameSpan=atSpan typeParams=[] params=[] hasRet=false ret=emptyTypeAst() whereParams=[] whereTraits=[] isAsync=false selfInout=false selfMove=false isVia=false viaName="" body=emptyBlock() assocTy=aty />)
                    } else {
                        p.advance()
                    }
                }
                }
            }
        }
    }
    return <ImplAst recvType=recvType implParams=implTps.names implParamSpans=implTps.nameSpans implParamSendable=implTps.isSendable isTraitImpl=isTraitImpl traitName=traitName traitNameSpan=traitNameSpan traitArgs=traitArgs whereParams=whereParams whereTraits=whereTraits whereTypes=whereTypes whereTraitTypes=whereTraitTypes isPub=isPub members=members span=<Span start=sStart end=p.prevEnd() /> extName=extName extNameSpan=extNameSpan />
}

// A body-less function signature `name[T,...](params) [-> ret]` (a trait requirement
// or extern declaration). The leading `fn`/`assoc fn`/`inout fn` is already consumed
// (the cursor is at the name); `isAssoc` records the form. Mirrors parseReqSig.
fn parseSigAst(p: inout P, isAssoc: Bool, selfInout: Bool = false) -> SigAst {
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    val params: Array[ParamAst] = parseParamAsts(p: inout p)
    mut val hasRet: Bool = false
    mut val ret: TypeAst = emptyTypeAst()
    match p.curKind() {
        Kind.Arrow => {
            p.advance()
            ret = parseType(p: inout p)
            hasRet = true
        }
        _ => {}
    }
    return <SigAst name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable params=params hasRet=hasRet ret=ret isAssoc=isAssoc selfInout=selfInout />
}

// A `trait Name [: Super + ...] { fn req ... ; type Item }` declaration (spec/08).
// The cursor is at the `trait` ident. Mirrors the compiler's parseTrait.
export fn parseTraitDecl(p: inout P) -> TraitAst {
    val sStart: U64 = p.base + p.curTok().start
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    // trait type parameters `trait Add[Rhs]` (spec/12), before `: Super` / `{`.
    val tps: TypeParamListAst = parseTypeParamList(p: inout p)
    mut val supertraits: Array[String] = []
    mut val supertraitSpans: Array[Span] = []
    match p.curKind() {
        Kind.Colon => {
            p.advance()
            mut val more: Bool = true
            while more {
                match p.curKind() {
                    Kind.Ident => {
                        val superTok: Tok = p.curTok()
                        supertraits.append(p.text(t: superTok))
                        supertraitSpans.append(p.spanOf(t: superTok))
                        p.advance()
                    }
                    _ => {}
                }
                match p.curKind() {
                    Kind.Plus => { p.advance() }
                    _ => { more = false }
                }
            }
        }
        _ => {}
    }
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => {}
    }
    mut val reqs: Array[SigAst] = []
    mut val assocTypes: Array[String] = []
    mut val assocTypeSpans: Array[Span] = []
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwFn => {
                p.advance()
                reqs.append(parseSigAst(p: inout p, isAssoc: false))
            }
            Kind.KwInout => {
                // `inout fn next()` requirement: conformance matches by selector, not
                // self-mode, so the `inout` is consumed and a plain req recorded.
                p.advance()
                match p.curKind() {
                    Kind.KwFn => { p.advance() }
                    _ => {}
                }
                reqs.append(parseSigAst(p: inout p, isAssoc: false, selfInout: true))
            }
            _ => {
                if curIs(p: inout p, kw: "factory") || curIs(p: inout p, kw: "optional") || curIs(p: inout p, kw: "result") {
                    // a factory requirement `[optional | result[E]] factory name(params)`
                    // (spec/05,12 — e.g. `TryFrom`'s `result[Error] factory checked(source:)`,
                    // `Chain`'s `factory fromValue/empty`). Recorded as an assoc-fn
                    // requirement by its SELECTOR (name + labels); the fallible wrapper
                    // (optional/result[E]) and the implicit `Self` return are the impl's
                    // concern. Witnessing matches by selector and the requirement return is
                    // left implicit (reqReturnMismatch is lenient for the Result/Optional/
                    // Self shape), so a conforming `impl I8 as TryFrom[I64]` factory satisfies
                    // it and the built-in-impl gate exempts the witnessing factory.
                    if curIs(p: inout p, kw: "optional") {
                        p.advance()
                    } else {
                        if curIs(p: inout p, kw: "result") {
                            p.advance()
                            match p.curKind() {
                                Kind.LBracket => {
                                    p.advance()
                                    val ignErr: TypeAst = parseType(p: inout p)
                                    match p.curKind() {
                                        Kind.RBracket => { p.advance() }
                                        _ => {}
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    if curIs(p: inout p, kw: "factory") {
                        p.advance()
                    }
                    reqs.append(parseSigAst(p: inout p, isAssoc: true))
                } else {
                if curIs(p: inout p, kw: "assoc") {
                    p.advance()
                    match p.curKind() {
                        Kind.KwFn => { p.advance() }
                        _ => {}
                    }
                    reqs.append(parseSigAst(p: inout p, isAssoc: true))
                } else {
                    if curIs(p: inout p, kw: "type") {
                        p.advance()
                        match p.curKind() {
                            Kind.Ident => {
                                val assocTok: Tok = p.curTok()
                                assocTypes.append(p.text(t: assocTok))
                                assocTypeSpans.append(p.spanOf(t: assocTok))
                                p.advance()
                            }
                            _ => {}
                        }
                    } else {
                        p.advance()
                    }
                }
                }
            }
        }
    }
    return <TraitAst name=name nameSpan=nameSpan typeParams=tps.names typeParamSpans=tps.nameSpans typeParamSendable=tps.isSendable supertraits=supertraits supertraitSpans=supertraitSpans reqs=reqs assocTypes=assocTypes assocTypeSpans=assocTypeSpans span=<Span start=sStart end=p.prevEnd() /> />
}

// An `extern(plewIntrinsic) { fn ... ; struct ... }` or `extern(c) { ... }`
// block (spec/15). The cursor is at the `extern` keyword.
export fn parseExternDecl(p: inout P) -> ExternAst {
    val externTok: Tok = p.curTok()
    val abiSpan: Span = p.spanOf(t: externTok)
    p.advance()
    mut val abiOk: Bool = false
    mut val abiC: Bool = false
    match p.curKind() {
        Kind.LParen => {
            // bareword ABI selector `extern(c)` / `extern(plewIntrinsic)` (spec/15):
            // ABI is a compiler-closed set, written without quotes (like import paths).
            p.advance()
            val t: Tok = p.curTok()
            if rangeEquals(bytes: p.bytes, start: t.start, len: t.len, kw: "c") {
                abiOk = true
                abiC = true
            } else {
                if rangeEquals(bytes: p.bytes, start: t.start, len: t.len, kw: "plewIntrinsic") {
                    abiOk = true
                }
            }
            p.advance()
            match p.curKind() {
                Kind.RParen => { p.advance() }
                _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `)` after extern ABI selector") }
            }
        }
        _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `(` after `extern` — write `extern(c)` or `extern(plewIntrinsic)`") }
    }
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `{` after extern ABI selector") }
    }
    mut val fns: Array[SigAst] = []
    mut val structNames: Array[String] = []
    mut val structNameSpans: Array[Span] = []
    mut val structTypeParams: Array[Array[String]] = []
    mut val structTypeParamSpans: Array[Array[Span]] = []
    mut val structTypeParamSendable: Array[Array[Bool]] = []
    mut val structSpans: Array[Span] = []
    mut val structDirectives: Array[DirectiveAst] = []
    // a `@[...]` directive seen since the last item — attached to the next struct/type
    // (spec/16: a derive on an opaque extern lang-item, e.g. `@[IntTryFrom] struct I8`).
    mut val pendingDir: DirectiveAst = <DirectiveAst reqs=[] />
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.KwFn => {
                p.advance()
                fns.append(parseSigAst(p: inout p, isAssoc: false))
                pendingDir = <DirectiveAst reqs=[] />
            }
            Kind.KwStruct => {
                val kwSpan: Span = p.spanOf(t: p.curTok())
                p.advance()
                val sTok: Tok = p.curTok()
                structNames.append(p.text(t: sTok))
                structNameSpans.append(p.spanOf(t: sTok))
                structSpans.append(<Span start=kwSpan.start end=p.spanOf(t: sTok).end />)
                structDirectives.append(pendingDir)
                pendingDir = <DirectiveAst reqs=[] />
                p.advance()
                // optional generic params `[T, …]` (`extern { struct Buffer[T] }`): a
                // generic opaque intrinsic. Non-generic structs get an empty list.
                val stps: TypeParamListAst = parseTypeParamList(p: inout p)
                structTypeParams.append(stps.names)
                structTypeParamSpans.append(stps.nameSpans)
                structTypeParamSendable.append(stps.isSendable)
            }
            _ => {
                // `type Name` — opaque foreign type (spec/15 FFI: `extern(c) { type
                // LLVMModuleRef }`). Captured like `struct Name` (a body-less opaque
                // type). `type` is a contextual keyword (an Ident), not a token kind.
                if curIs(p: inout p, kw: "type") {
                    val kwSpan: Span = p.spanOf(t: p.curTok())
                    p.advance()
                    val tTok: Tok = p.curTok()
                    structNames.append(p.text(t: tTok))
                    structNameSpans.append(p.spanOf(t: tTok))
                    structTypeParams.append([])
                    structTypeParamSpans.append([])
                    structTypeParamSendable.append([])
                    structSpans.append(<Span start=kwSpan.start end=p.spanOf(t: tTok).end />)
                    structDirectives.append(pendingDir)
                    pendingDir = <DirectiveAst reqs=[] />
                    p.advance()
                } else {
                    // a `@[...]` directive (the `@` token followed by `[`) annotating the
                    // next struct/type — parse and stash it; otherwise skip one token.
                    if p.peekKind(off: 1) == <Kind.LBracket /> {
                        pendingDir = parseDirectiveAst(p: inout p)
                    } else {
                        p.advance()
                    }
                }
            }
        }
    }
    return <ExternAst abiOk=abiOk abiC=abiC abiSpan=abiSpan fns=fns structNames=structNames structNameSpans=structNameSpans structTypeParams=structTypeParams structTypeParamSpans=structTypeParamSpans structTypeParamSendable=structTypeParamSendable structSpans=structSpans structDirectives=structDirectives span=<Span start=p.base + externTok.start end=p.prevEnd() /> />
}

// `import <path> [with { name [as Q], ... }]` or `part <path>` (spec/15). The cursor
// is at the `import`/`part` ident (`isImport` distinguishes: an import starts a fresh
// module, a part joins the current one). Captures the full contiguous path span (for
// the loader to resolve to a file — parse-driven loading), the last segment, and each
// `with` name (original span — feeds moduleOf for the importing module). A `part` has
// no `with` list. Mirrors the compiler's parseImport + collectParts.
fn parseImportAst(p: inout P, isImport: Bool) -> ImportAst {
    val startOff: U64 = p.base + p.curTok().start
    p.advance()
    return parseImportTail(p: inout p, isImport: isImport, reExport: false, startOff: startOff)
}

// The path + `with { names }` body of an `import`/`part`/re-export, with the cursor
// already past the leading keyword (`import`/`part`/`export`). `startOff` is the
// keyword's offset (for the item span). Shared so a re-export (`export <path> with
// { … }`) parses its path/names with the exact same machinery as `import`.
fn parseImportTail(p: inout P, isImport: Bool, reExport: Bool, startOff: U64) -> ImportAst {
    // the path = contiguous tokens (`@`/`.`/`..`/`/` markers + segments), stopping
    // before a space-separated `with`, a `{`, or a newline.
    mut val pathStart: U64 = p.base + p.curTok().start
    mut val pathEndSlice: U64 = p.curTok().start
    mut val segStartAbs: U64 = pathStart
    mut val segLen: U64 = 0
    mut val firstPath: Bool = true
    mut val sawWith: Bool = false
    while true {
        match p.curKind() {
            Kind.Newline => { break }
            Kind.Eof => { break }
            Kind.LBrace => { break }
            _ => {
                if curIs(p: inout p, kw: "with") {
                    p.advance()
                    sawWith = true
                    break
                }
                val t: Tok = p.curTok()
                if !(firstPath) {
                    if t.start != pathEndSlice {
                        break
                    }
                }
                firstPath = false
                pathEndSlice = t.start + t.len
                match t.kind {
                    Kind.Ident => {
                        segStartAbs = p.base + t.start
                        segLen = t.len
                    }
                    _ => {}
                }
                p.advance()
            }
        }
    }
    val pathEndAbs: U64 = p.base + pathEndSlice
    // a path-level alias `import <path> as F` (spec/15): rename the namespace to F.
    mut val aliasSpan: Span = <Span start=0 end=0 />
    match p.curKind() {
        Kind.KwAs => {
            p.advance()
            match p.curKind() {
                Kind.Ident => {
                    aliasSpan = p.spanOf(t: p.curTok())
                    p.advance()
                }
                _ => {}
            }
            // `as F with { … }` is allowed; fall through to the `with` scan below.
            match p.curKind() {
                Kind.Ident => {
                    if curIs(p: inout p, kw: "with") {
                        p.advance()
                        sawWith = true
                    }
                }
                _ => {}
            }
        }
        _ => {}
    }
    mut val names: Array[String] = []
    mut val nameSpans: Array[Span] = []
    mut val nameAliasSpans: Array[Span] = []
    // `with` must be followed by a `{ … }` selection. Wildcard `import … with *` is
    // intentionally not supported (spec/15): it hides provenance — use a namespace
    // import `import <path>` (then `Ns.name`) for broad access, or `with { … }`.
    if sawWith {
        if !reExport {
            match p.curKind() {
                Kind.LBrace => {}
                Kind.Star => { p.fail(off: p.base + p.curTok().start, msg: "wildcard import `with *` is not supported (spec/15): use a namespace import `import <path>` (then refer to `Ns.name`) for broad access, or `with { … }` to select names") }
                _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `{ … }` after `with` in an import") }
            }
        }
    }
    match p.curKind() {
        Kind.LBrace => {
            p.advance()
            while true {
                p.skipNewlines()
                match p.curKind() {
                    Kind.RBrace => {
                        p.advance()
                        break
                    }
                    Kind.Eof => { break }
                    Kind.Comma => { p.advance() }
                    Kind.Ident => {
                        val t: Tok = p.curTok()
                        names.append(p.text(t: t))
                        nameSpans.append(p.spanOf(t: t))
                        p.advance()
                        // `name as Q`: bind the local alias `Q` to the imported `name`.
                        mut val alias: Span = <Span start=0 end=0 />
                        match p.curKind() {
                            Kind.KwAs => {
                                p.advance()
                                match p.curKind() {
                                    Kind.Ident => {
                                        alias = p.spanOf(t: p.curTok())
                                        p.advance()
                                    }
                                    _ => {}
                                }
                            }
                            _ => {}
                        }
                        nameAliasSpans.append(alias)
                    }
                    _ => { p.advance() }
                }
            }
        }
        _ => {}
    }
    return <ImportAst pathSpan=<Span start=pathStart end=pathEndAbs /> segSpan=<Span start=segStartAbs end=segStartAbs + segLen /> isImport=isImport names=names nameSpans=nameSpans aliasSpan=aliasSpan nameAliasSpans=nameAliasSpans span=<Span start=startOff end=p.prevEnd() /> />
}

// Optional directive arguments `(label: expr, ...)` after a derive name (spec/16).
// Mirrors the compiler's parseDirectiveArgs.
fn parseDirectiveArgsAst(p: inout P) -> Array[MakeFieldAst] {
    mut val fields: Array[MakeFieldAst] = []
    match p.curKind() {
        Kind.LParen => { p.advance() }
        _ => { return fields }
    }
    while true {
        p.skipNewlines()
        match p.curKind() {
            Kind.RParen => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Comma => { p.advance() }
            Kind.Ident => {
                val labelTok: Tok = p.curTok()
                val label: String = p.text(t: labelTok)
                val labelSpan: Span = p.spanOf(t: labelTok)
                p.advance()
                match p.curKind() {
                    Kind.Colon => { p.advance() }
                    _ => {}
                }
                val v: ExprAst = parseExprAst(p: inout p)
                fields.append(<MakeFieldAst name=label nameSpan=labelSpan value=v span=labelSpan />)
            }
            _ => { p.advance() }
        }
    }
    return fields
}

// `@[Name, Name(a: 32), ...]` directive (spec/16). The cursor is at the `@` (lexed
// as Unknown). Mirrors the compiler's parseDirective.
fn parseDirectiveAst(p: inout P) -> DirectiveAst {
    p.advance()
    match p.curKind() {
        Kind.LBracket => { p.advance() }
        _ => {}
    }
    mut val reqs: Array[DeriveReqAst] = []
    while true {
        match p.curKind() {
            Kind.RBracket => {
                p.advance()
                break
            }
            Kind.Eof => { break }
            Kind.Comma => { p.advance() }
            Kind.Ident => {
                val t: Tok = p.curTok()
                val name: String = p.text(t: t)
                val nameSpan: Span = p.spanOf(t: t)
                p.advance()
                val args: Array[MakeFieldAst] = parseDirectiveArgsAst(p: inout p)
                reqs.append(<DeriveReqAst name=name nameSpan=nameSpan args=args />)
            }
            _ => { p.advance() }
        }
    }
    return <DirectiveAst reqs=reqs />
}

// `export <decl> | export extern { } | export <path> [with]` (spec/15). The cursor
// is at the `export` ident. Returns the wrapped item (`Export`) or a re-export path
// (`ReExport`, recorded as nothing for now). Mirrors the compiler's parseExport.
fn parseExportAst(p: inout P) -> TopItemAst {
    val startOff: U64 = p.base + p.curTok().start
    p.advance()
    // A declaration keyword (or contextual `trait`/`newtype`) → `export <decl>`. Anything
    // else is a re-export path (`export ./X` / `export @Std/X` / `export /X` [with { … }]),
    // parsed with the shared import-tail machinery (spec/15). The `@…` form is supported:
    // the `@` lexes as Unknown and is consumed as a contiguous path token like any other.
    match p.curKind() {
        Kind.KwExtern => { return <TopItemAst.Export inner=<TopItemAst.Extern e=parseExternDecl(p: inout p) /> /> }
        Kind.KwFn => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwSpawn => {
            p.fail(off: p.base + p.curTok().start, msg: "`export spawn fn` is rejected in v1 until spawn-boundary sendability/effect checking is available")
            return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> />
        }
        Kind.KwAsync => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwStruct => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwUnique => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwNonsendable => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwEnum => { return <TopItemAst.Export inner=<TopItemAst.Decl d=parseDecl(p: inout p) /> /> }
        Kind.KwVal => { return <TopItemAst.Export inner=<TopItemAst.GlobalVal s=parseLetAst(p: inout p, mutable: false) /> /> }
        Kind.KwMut => {
            p.advance()
            return <TopItemAst.Export inner=<TopItemAst.GlobalVal s=parseLetAst(p: inout p, mutable: true) /> />
        }
        Kind.Ident => {
            if curIs(p: inout p, kw: "trait") {
                return <TopItemAst.Export inner=<TopItemAst.Trait t=parseTraitDecl(p: inout p) /> />
            }
            // `export newtype Name = Underlying` (spec/10,15): `newtype` is a contextual
            // keyword (an Ident), so it lands here rather than in a `Kind.Kw…` arm.
            if curIs(p: inout p, kw: "newtype") {
                return <TopItemAst.Export inner=parseNewtypeAst(p: inout p, isPub: false) />
            }
            return <TopItemAst.ReExport imp=parseImportTail(p: inout p, isImport: true, reExport: true, startOff: startOff) />
        }
        _ => { return <TopItemAst.ReExport imp=parseImportTail(p: inout p, isImport: true, reExport: true, startOff: startOff) /> }
    }
}

// Parse an `extension Name { impl ... impl ... }` block (spec/09): a named
// bundle of impl blocks. Each impl is emitted as an ordinary TopItemAst.Impl
// tagged with the extension name (so its members reach resolution only through a
// call-site `value#Name.member` view). The extension itself carries no other
// state — it is purely a label on its impls.
fn parseExtensionInto(p: inout P, items: inout Array[TopItemAst]) {
    p.advance()
    val nameTok: Tok = p.curTok()
    val name: String = p.text(t: nameTok)
    val nameSpan: Span = p.spanOf(t: nameTok)
    p.advance()
    match p.curKind() {
        Kind.LBrace => { p.advance() }
        _ => { p.fail(off: p.base + p.curTok().start, msg: "expected `{` after `extension Name`") }
    }
    mut val cont: Bool = true
    while cont {
        p.skipNewlines()
        match p.curKind() {
            Kind.RBrace => {
                p.advance()
                cont = false
            }
            Kind.Eof => { cont = false }
            _ => {
                if curIs(p: inout p, kw: "impl") {
                    items.append(<TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: false, extName: name, extNameSpan: nameSpan) />)
                } else {
                    if curIs(p: inout p, kw: "pub") {
                        p.advance()
                        if curIs(p: inout p, kw: "impl") {
                            items.append(<TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: true, extName: name, extNameSpan: nameSpan) />)
                        } else {
                            p.advance()
                        }
                    } else {
                        p.advance()
                    }
                }
            }
        }
    }
}

// Parse exactly one top-level source position. An extension is deliberately one
// source position but expands to several Impl items, hence the small returned
// list. Both the value-AST and SyntaxFile entry points consume this one dispatch;
// there must not be a second compiler-only top-level grammar.
fn parseTopItemsAt(p: inout P) -> Array[TopItemAst] {
    mut val items: Array[TopItemAst] = []
    p.skipNewlines()
    match p.curKind() {
            Kind.KwFn => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwSpawn => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwAsync => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwStruct => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwUnique => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwNonsendable => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwEnum => { items.append(<TopItemAst.Decl d=parseDecl(p: inout p) />) }
            Kind.KwExtern => { items.append(<TopItemAst.Extern e=parseExternDecl(p: inout p) />) }
            Kind.KwVal => { items.append(<TopItemAst.GlobalVal s=parseLetAst(p: inout p, mutable: false) />) }
            Kind.KwMut => {
                p.advance()
                items.append(<TopItemAst.GlobalVal s=parseLetAst(p: inout p, mutable: true) />)
            }
            Kind.Ident => {
                if curIs(p: inout p, kw: "import") {
                    items.append(<TopItemAst.Import imp=parseImportAst(p: inout p, isImport: true) />)
                } else {
                    if curIs(p: inout p, kw: "part") {
                        items.append(<TopItemAst.Import imp=parseImportAst(p: inout p, isImport: false) />)
                    } else {
                        if curIs(p: inout p, kw: "export") {
                            items.append(parseExportAst(p: inout p))
                        } else {
                            if curIs(p: inout p, kw: "impl") {
                                items.append(<TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: false) />)
                            } else {
                                if curIs(p: inout p, kw: "pub") {
                                    p.advance()
                                    if curIs(p: inout p, kw: "impl") {
                                        items.append(<TopItemAst.Impl im=parseImplDecl(p: inout p, isPub: true) />)
                                    } else {
                                        p.fail(off: p.base + p.curTok().start, msg: "expected `impl` after `pub` at the top level (top-level visibility is `export`, spec/15)")
                                        p.advance()
                                    }
                                } else {
                                    if curIs(p: inout p, kw: "trait") {
                                        items.append(<TopItemAst.Trait t=parseTraitDecl(p: inout p) />)
                                    } else {
                                        if curIs(p: inout p, kw: "extension") {
                                            parseExtensionInto(p: inout p, items: inout items)
                                        } else {
                                            if curIs(p: inout p, kw: "newtype") {
                                                items.append(parseNewtypeAst(p: inout p, isPub: false))
                                            } else {
                                                // an identifier that starts no top-level item: reporting
                                                // instead of skipping — a silently dropped token is
                                                // hidden meaning (what was spoken did not manifest).
                                                p.fail(off: p.base + p.curTok().start, msg: "unknown top-level item — expected a declaration (fn / struct / enum / trait / impl / extension / newtype / import / part / export / val)")
                                                p.advance()
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Kind.Eof => {}
            _ => {
                if p.peekKind(off: 1) == <Kind.LBracket /> {
                    items.append(<TopItemAst.Directive dir=parseDirectiveAst(p: inout p) />)
                } else {
                    // a stray token at the top level (`}` from an over-closed block,
                    // punctuation, garbage): report, don't silently swallow.
                    p.fail(off: p.base + p.curTok().start, msg: "unexpected token at the top level — expected a declaration (fn / struct / enum / trait / impl / extension / newtype / import / part / export / val)")
                    p.advance()
                }
            }
    }
    return items
}

// Parse a whole program (a file's tokens) into a flat list of top-level items
// (spec/15). The compiler frontend drives this over its own token stream (base=0)
// and lowers each item (Codegen/Lower.pw), following `Import` items to load further
// files. This is the single top-level entry — the compiler has no separate
// declaration/dispatch parser. Mirrors the compiler's old parseProgram dispatch.
export fn parseProgramAst(p: inout P) -> Array[TopItemAst] {
    mut val items: Array[TopItemAst] = []
    while p.curKind() != <Kind.Eof /> {
        val next: Array[TopItemAst] = parseTopItemsAt(p: inout p)
        mut val i: U64 = 0U64
        while i < next.count() {
            items.append(next[i])
            i += 1U64
        }
    }
    return items
}

// Compiler entry point.  Parsing remains the same recoverable value-AST parser
// used by macros; each completed top-level item is immediately frozen into the
// immutable, ID-addressed representation and the program-sized value array is
// discarded before returning.
export fn parseProgramSyntaxFile(p: inout P) -> SyntaxFile {
    mut val file: SyntaxFile = <SyntaxFile />
    parseProgramSyntaxInto(p: inout p, file: inout file)
    return file
}

// Compiler loader entry: append one source file to the single program-owned
// syntax store and return precisely the roots added for this file.  This is the
// only post-factory mutation exposed by SyntaxFile; ordinary consumers receive
// the completed file as `val` and have read-only ID traversal only.
export fn parseProgramSyntaxInto(p: inout P, file: inout SyntaxFile) -> SyntaxSlice {
    val start: U64 = file.topLevelCount()
    while p.curKind() != <Kind.Eof /> {
        val items: Array[TopItemAst] = parseTopItemsAt(p: inout p)
        mut val i: U64 = 0U64
        while i < items.count() {
            file.freezeTopItem(ast: items[i])
            i += 1U64
        }
    }
    return <SyntaxSlice start=start count=file.topLevelCount() - start />
}

// Read-only traversal surface for compiler clients.  Tables stay private so no
// caller can append a node after parse/freeze has established the ID graph.
export fn syntaxFileTopLevelCount(file: SyntaxFile) -> U64 {
    return file.topLevelCount()
}

export fn syntaxFileTopLevel(file: SyntaxFile, index: U64) -> TopItemId {
    return file.topLevelItem(index: index)
}

