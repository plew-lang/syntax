        return <SyntaxSlice start=start count=items.count() />
    }

    inout fn pushMatchArmIdSlice(items: Array[MatchArmId]) -> SyntaxSlice {
        val start: U64 = self.matchArmIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.matchArmIds.append(items[i])
            i += 1U64
