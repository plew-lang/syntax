    inout fn pushFieldIdSlice(items: Array[FieldId]) -> SyntaxSlice {
        val start: U64 = self.fieldIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.fieldIds.append(items[i])
            i += 1U64
