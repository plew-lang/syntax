// Compiler-facing immutable syntax arena builder. The parser owns mutation while
// constructing a SyntaxFile; consumers receive it as a `val` and use IDs/slices.
// This part intentionally contains only impl blocks (spec/15 part rule).

pub impl SyntaxSlice { factory }
pub impl TopItemId { factory }
pub impl DeclId { factory }
pub impl ImplId { factory }
pub impl TraitId { factory }
pub impl ExternId { factory }
pub impl ImportId { factory }
pub impl DirectiveId { factory }
pub impl NewtypeId { factory }
pub impl TypeId { factory }
pub impl FieldId { factory }
pub impl VariantId { factory }
pub impl ParamId { factory }
pub impl MemberId { factory }
pub impl SigId { factory }
pub impl StmtId { factory }
pub impl ExprId { factory }
pub impl BlockId { factory }
pub impl PatternId { factory }
pub impl MatchArmId { factory }
pub impl ArgId { factory }
pub impl MakeFieldId { factory }
pub impl BindId { factory }
pub impl DeriveReqId { factory }
pub impl SyntaxTopItem { factory }
pub impl SyntaxType { factory }
pub impl SyntaxField { factory }
pub impl SyntaxVariant { factory }
pub impl SyntaxParam { factory }
pub impl SyntaxDecl { factory }
pub impl SyntaxMember { factory }
pub impl SyntaxSig { factory }
pub impl SyntaxTrait { factory }
pub impl SyntaxExtern { factory }
pub impl SyntaxImpl { factory }
pub impl SyntaxImport { factory }
pub impl SyntaxDeriveReq { factory }
pub impl SyntaxDirective { factory }
pub impl SyntaxNewtype { factory }
pub impl SyntaxExpr { factory }
pub impl SyntaxArg { factory }
pub impl SyntaxMakeField { factory }
pub impl SyntaxBind { factory }
pub impl SyntaxPattern { factory }
pub impl SyntaxMatchArm { factory }
pub impl SyntaxBlock { factory }
pub impl SyntaxStmt { factory }

pub impl SyntaxFile {
    factory

    // This is deliberately one-way: macro value ASTs may be frozen for a
    // compiler input, but SyntaxFile never exposes a materialize operation.
    inout fn freezeTopItem(ast: TopItemAst) -> TopItemId {
        val id: TopItemId = self.freezeTopItemAst(ast: ast)
        self.topLevel.append(id)
        return id
    }

    fn topLevelCount() -> U64 { return self.topLevel.count() }
    fn topLevelItem(index: U64) -> TopItemId { return self.topLevel[index] }
    fn topItemKind(item: TopItemId) -> SyntaxTopItemKind { return self.topItems[item.raw].kind }
    fn topItemSpan(item: TopItemId) -> Span { return self.topItems[item.raw].span }
    fn topItemPayload(item: TopItemId) -> U64 { return self.topItems[item.raw].payload }
    fn importNode(id: ImportId) -> SyntaxImport { return self.imports[id.raw] }
    fn declNode(id: DeclId) -> SyntaxDecl { return self.decls[id.raw] }
    fn fieldNode(id: FieldId) -> SyntaxField { return self.fields[id.raw] }
    fn variantNode(id: VariantId) -> SyntaxVariant { return self.variants[id.raw] }
    fn paramNode(id: ParamId) -> SyntaxParam { return self.params[id.raw] }
    fn memberNode(id: MemberId) -> SyntaxMember { return self.members[id.raw] }
    fn sigNode(id: SigId) -> SyntaxSig { return self.sigs[id.raw] }
    fn blockNode(id: BlockId) -> SyntaxBlock { return self.blocks[id.raw] }
    fn exprNode(id: ExprId) -> SyntaxExpr { return self.exprs[id.raw] }
    fn argNode(id: ArgId) -> SyntaxArg { return self.args[id.raw] }
    fn makeFieldNode(id: MakeFieldId) -> SyntaxMakeField { return self.makeFields[id.raw] }
    fn matchArmNode(id: MatchArmId) -> SyntaxMatchArm { return self.matchArms[id.raw] }
    fn patternNode(id: PatternId) -> SyntaxPattern { return self.patterns[id.raw] }
    fn bindNode(id: BindId) -> SyntaxBind { return self.binds[id.raw] }
    fn deriveReqNode(id: DeriveReqId) -> SyntaxDeriveReq { return self.deriveReqs[id.raw] }
    fn implNode(id: ImplId) -> SyntaxImpl { return self.impls[id.raw] }
    fn traitNode(id: TraitId) -> SyntaxTrait { return self.traits[id.raw] }
    fn externNode(id: ExternId) -> SyntaxExtern { return self.externs[id.raw] }
    fn directiveNode(id: DirectiveId) -> SyntaxDirective { return self.directives[id.raw] }
    fn newtypeNode(id: NewtypeId) -> SyntaxNewtype { return self.newtypes[id.raw] }
    fn stmtNode(id: StmtId) -> SyntaxStmt { return self.stmts[id.raw] }
    fn typeNode(id: TypeId) -> SyntaxType { return self.types[id.raw] }
    fn typeArgCount(ty: SyntaxType) -> U64 { return ty.args.count }
    fn typeArg(ty: SyntaxType, index: U64) -> TypeId {
        return self.typeIds[ty.args.start + index]
    }
    fn typeArgLabel(ty: SyntaxType, index: U64) -> Span {
        return self.texts[ty.argLabels.start + index]
    }
    fn declFieldCount(decl: SyntaxDecl) -> U64 { return decl.fields.count }
    fn declField(decl: SyntaxDecl, index: U64) -> FieldId {
        return self.fieldIds[decl.fields.start + index]
    }
    fn declTypeParamCount(decl: SyntaxDecl) -> U64 { return decl.typeParams.count }
    fn declTypeParamSpan(decl: SyntaxDecl, index: U64) -> Span {
        return self.texts[decl.typeParams.start + index]
    }
    fn declTypeParamIsSendable(decl: SyntaxDecl, index: U64) -> Bool {
        return self.bools[decl.typeParamSendable.start + index]
    }
    fn declVariantCount(decl: SyntaxDecl) -> U64 { return decl.variants.count }
    fn declVariant(decl: SyntaxDecl, index: U64) -> VariantId {
        return self.variantIds[decl.variants.start + index]
    }
    fn variantFieldCount(variant: SyntaxVariant) -> U64 { return variant.fields.count }
    fn variantField(variant: SyntaxVariant, index: U64) -> FieldId {
        return self.fieldIds[variant.fields.start + index]
    }
    fn declParamCount(decl: SyntaxDecl) -> U64 { return decl.params.count }
    fn declParam(decl: SyntaxDecl, index: U64) -> ParamId {
        return self.paramIds[decl.params.start + index]
    }
    fn declWhereCount(decl: SyntaxDecl) -> U64 { return decl.whereParams.count }
    fn declWhereParamSpan(decl: SyntaxDecl, index: U64) -> Span {
        return self.texts[decl.whereParams.start + index]
    }
    fn declWhereTraitSpan(decl: SyntaxDecl, index: U64) -> Span {
        return self.texts[decl.whereTraits.start + index]
    }
    fn declWhereType(decl: SyntaxDecl, index: U64) -> TypeId {
        return self.typeIds[decl.whereTypes.start + index]
    }
    fn declWhereTraitType(decl: SyntaxDecl, index: U64) -> TypeId {
        return self.typeIds[decl.whereTraitTypes.start + index]
    }
    fn traitTypeParamCount(trait: SyntaxTrait) -> U64 { return trait.typeParams.count }
    fn traitTypeParamSpan(trait: SyntaxTrait, index: U64) -> Span {
        return self.texts[trait.typeParams.start + index]
    }
    fn traitTypeParamIsSendable(trait: SyntaxTrait, index: U64) -> Bool {
        return self.bools[trait.typeParamSendable.start + index]
    }
    fn traitSupertraitCount(trait: SyntaxTrait) -> U64 { return trait.supertraits.count }
    fn traitSupertraitSpan(trait: SyntaxTrait, index: U64) -> Span {
        return self.texts[trait.supertraits.start + index]
    }
    fn traitAssocTypeCount(trait: SyntaxTrait) -> U64 { return trait.assocTypes.count }
    fn traitAssocTypeSpan(trait: SyntaxTrait, index: U64) -> Span {
        return self.texts[trait.assocTypes.start + index]
    }
    fn traitReqCount(trait: SyntaxTrait) -> U64 { return trait.reqs.count }
    fn traitReq(trait: SyntaxTrait, index: U64) -> SigId {
        return self.sigIds[trait.reqs.start + index]
    }
    fn sigTypeParamCount(sig: SyntaxSig) -> U64 { return sig.typeParams.count }
    fn sigTypeParamSpan(sig: SyntaxSig, index: U64) -> Span {
        return self.texts[sig.typeParams.start + index]
    }
    fn sigTypeParamIsSendable(sig: SyntaxSig, index: U64) -> Bool {
        return self.bools[sig.typeParamSendable.start + index]
    }
    fn sigParamCount(sig: SyntaxSig) -> U64 { return sig.params.count }
    fn sigParam(sig: SyntaxSig, index: U64) -> ParamId {
        return self.paramIds[sig.params.start + index]
    }
    fn implParamCount(impl: SyntaxImpl) -> U64 { return impl.implParams.count }
    fn implParamSpan(impl: SyntaxImpl, index: U64) -> Span {
        return self.texts[impl.implParams.start + index]
    }
    fn implParamIsSendable(impl: SyntaxImpl, index: U64) -> Bool {
        return self.bools[impl.implParamSendable.start + index]
    }
    fn implTraitArgCount(impl: SyntaxImpl) -> U64 { return impl.traitArgs.count }
    fn implTraitArg(impl: SyntaxImpl, index: U64) -> TypeId {
        return self.typeIds[impl.traitArgs.start + index]
    }
    fn implWhereCount(impl: SyntaxImpl) -> U64 { return impl.whereParams.count }
    fn implWhereParamSpan(impl: SyntaxImpl, index: U64) -> Span {
        return self.texts[impl.whereParams.start + index]
    }
    fn implWhereTraitSpan(impl: SyntaxImpl, index: U64) -> Span {
        return self.texts[impl.whereTraits.start + index]
    }
    fn implWhereType(impl: SyntaxImpl, index: U64) -> TypeId {
        return self.typeIds[impl.whereTypes.start + index]
    }
    fn implWhereTraitType(impl: SyntaxImpl, index: U64) -> TypeId {
        return self.typeIds[impl.whereTraitTypes.start + index]
    }
    fn implMemberCount(impl: SyntaxImpl) -> U64 { return impl.members.count }
    fn implMember(impl: SyntaxImpl, index: U64) -> MemberId {
        return self.memberIds[impl.members.start + index]
    }
    fn memberTypeParamCount(member: SyntaxMember) -> U64 { return member.typeParams.count }
    fn memberTypeParamSpan(member: SyntaxMember, index: U64) -> Span {
        return self.texts[member.typeParams.start + index]
    }
    fn memberTypeParamIsSendable(member: SyntaxMember, index: U64) -> Bool {
        return self.bools[member.typeParamSendable.start + index]
    }
    fn memberParamCount(member: SyntaxMember) -> U64 { return member.params.count }
    fn memberParam(member: SyntaxMember, index: U64) -> ParamId {
        return self.paramIds[member.params.start + index]
    }
    fn memberWhereCount(member: SyntaxMember) -> U64 { return member.whereParams.count }
    fn memberWhereParamSpan(member: SyntaxMember, index: U64) -> Span {
        return self.texts[member.whereParams.start + index]
    }
    fn memberWhereTraitSpan(member: SyntaxMember, index: U64) -> Span {
        return self.texts[member.whereTraits.start + index]
    }
    fn memberWhereType(member: SyntaxMember, index: U64) -> TypeId {
        return self.typeIds[member.whereTypes.start + index]
    }
    fn memberWhereTraitType(member: SyntaxMember, index: U64) -> TypeId {
        return self.typeIds[member.whereTraitTypes.start + index]
    }
    fn externFnCount(ext: SyntaxExtern) -> U64 { return ext.fns.count }
    fn externFn(ext: SyntaxExtern, index: U64) -> SigId {
        return self.sigIds[ext.fns.start + index]
    }
    fn externStructCount(ext: SyntaxExtern) -> U64 { return ext.structNames.count }
    fn externStructNameSpan(ext: SyntaxExtern, index: U64) -> Span {
        return self.texts[ext.structNames.start + index]
    }
    fn externStructSpan(ext: SyntaxExtern, index: U64) -> Span {
        return self.texts[ext.structSpans.start + index]
    }
    fn externStructTypeParamCount(ext: SyntaxExtern, index: U64) -> U64 {
        return self.slices[ext.structTypeParams.start + index].count
    }
    fn externStructTypeParamSpan(ext: SyntaxExtern, structIndex: U64, index: U64) -> Span {
        val params: SyntaxSlice = self.slices[ext.structTypeParams.start + structIndex]
        return self.texts[params.start + index]
    }
    fn externStructTypeParamIsSendable(ext: SyntaxExtern, structIndex: U64, index: U64) -> Bool {
        val params: SyntaxSlice = self.slices[ext.structTypeParamSendable.start + structIndex]
        return self.bools[params.start + index]
    }
    fn externStructDirective(ext: SyntaxExtern, index: U64) -> DirectiveId {
        return self.directiveIds[ext.structDirectives.start + index]
    }
    fn directiveReqCount(directive: SyntaxDirective) -> U64 { return directive.reqs.count }
    fn directiveReq(directive: SyntaxDirective, index: U64) -> DeriveReqId {
        return self.deriveReqIds[directive.reqs.start + index]
    }
    fn deriveReqArgCount(req: SyntaxDeriveReq) -> U64 { return req.args.count }
    fn deriveReqArg(req: SyntaxDeriveReq, index: U64) -> MakeFieldId {
        return self.makeFieldIds[req.args.start + index]
    }
    fn blockStmtCount(block: SyntaxBlock) -> U64 { return block.stmts.count }
    fn blockStmt(block: SyntaxBlock, index: U64) -> StmtId {
        return self.stmtIds[block.stmts.start + index]
    }
    fn exprArgCount(expr: SyntaxExpr) -> U64 { return expr.args.count }
    fn exprArg(expr: SyntaxExpr, index: U64) -> ArgId {
        return self.argIds[expr.args.start + index]
    }
    fn exprElemCount(expr: SyntaxExpr) -> U64 { return expr.elems.count }
    fn exprElem(expr: SyntaxExpr, index: U64) -> ExprId {
        return self.exprIds[expr.elems.start + index]
    }
    fn exprMakeFieldCount(expr: SyntaxExpr) -> U64 { return expr.fields.count }
    fn exprMakeField(expr: SyntaxExpr, index: U64) -> MakeFieldId {
        return self.makeFieldIds[expr.fields.start + index]
    }
    fn exprDictEntryCount(expr: SyntaxExpr) -> U64 { return expr.keys.count }
    fn exprDictKey(expr: SyntaxExpr, index: U64) -> ExprId {
        return self.exprIds[expr.keys.start + index]
    }
    fn exprDictValue(expr: SyntaxExpr, index: U64) -> ExprId {
        return self.exprIds[expr.values.start + index]
    }
    fn stmtMatchArmCount(stmt: SyntaxStmt) -> U64 { return stmt.arms.count }
    fn stmtMatchArm(stmt: SyntaxStmt, index: U64) -> MatchArmId {
        return self.matchArmIds[stmt.arms.start + index]
    }
    fn exprMatchArmCount(expr: SyntaxExpr) -> U64 { return expr.arms.count }
    fn exprMatchArm(expr: SyntaxExpr, index: U64) -> MatchArmId {
        return self.matchArmIds[expr.arms.start + index]
    }
    fn stmtBindCount(stmt: SyntaxStmt) -> U64 { return stmt.binds.count }
    fn stmtBind(stmt: SyntaxStmt, index: U64) -> BindId {
        return self.bindIds[stmt.binds.start + index]
    }
    fn patternBindCount(pattern: SyntaxPattern) -> U64 { return pattern.binds.count }
    fn patternBind(pattern: SyntaxPattern, index: U64) -> BindId {
        return self.bindIds[pattern.binds.start + index]
    }
    fn exprParamCount(expr: SyntaxExpr) -> U64 { return expr.params.count }
    fn exprParam(expr: SyntaxExpr, index: U64) -> ParamId {
        return self.paramIds[expr.params.start + index]
    }
    fn exprTypeArgCount(expr: SyntaxExpr) -> U64 { return expr.typeArgs.count }
    fn exprTypeArg(expr: SyntaxExpr, index: U64) -> TypeId {
        return self.typeIds[expr.typeArgs.start + index]
    }
    fn typeViewNameCount(ty: SyntaxType) -> U64 { return ty.viewNames.count }
    fn typeViewName(ty: SyntaxType, index: U64) -> Span {
        return self.texts[ty.viewNames.start + index]
    }
    fn typeProjectionTraitArgCount(ty: SyntaxType) -> U64 { return ty.projectionTraitArgs.count }
    fn typeProjectionTraitArg(ty: SyntaxType, index: U64) -> TypeId {
        return self.typeIds[ty.projectionTraitArgs.start + index]
    }
    fn typeProjectionTraitArgLabel(ty: SyntaxType, index: U64) -> Span {
        return self.texts[ty.projectionTraitArgLabels.start + index]
    }
    // Keep pool addressing inside SyntaxFile.  A SyntaxSlice has no runtime
    // element type, so exposing a generic text-slice reader would let compiler
    // clients accidentally interpret (for example) an ExprId slice as names.
    fn importNameCount(imp: SyntaxImport) -> U64 { return imp.nameSpans.count }
    fn importNameSpan(imp: SyntaxImport, index: U64) -> Span {
        return self.texts[imp.nameSpans.start + index]
    }
    fn importNameAliasSpan(imp: SyntaxImport, index: U64) -> Span {
        return self.texts[imp.nameAliases.start + index]
    }
    fn externHasDeriveDirective(id: ExternId) -> Bool {
        val ext: SyntaxExtern = self.externs[id.raw]
        mut val i: U64 = 0U64
        while i < ext.structDirectives.count {
            val directive: DirectiveId = self.directiveIds[ext.structDirectives.start + i]
            if self.directives[directive.raw].reqs.count > 0U64 { return true }
            i += 1U64
        }
        return false
    }
}

impl SyntaxFile {
    fn emptySlice() -> SyntaxSlice {
        return <SyntaxSlice start=0U64 count=0U64 />
    }

    // The only construction path for expression rows.  Fields not selected by
    // `kind` are deliberately inert; consumers must switch on the closed tag.
    inout fn pushExprNode(
        kind: SyntaxExprKind,
        span: Span,
        text: Span = <Span start=0 end=0 />,
        name: Span = <Span start=0 end=0 />,
        nameSpan: Span = <Span start=0 end=0 />,
        op: I64 = 0,
        intValue: U64 = 0U64,
        flag0: Bool = false,
        flag1: Bool = false,
        child0: ExprId = <ExprId raw=0U64 />,
        child1: ExprId = <ExprId raw=0U64 />,
        child2: ExprId = <ExprId raw=0U64 />,
        type0: TypeId = <TypeId raw=0U64 />,
        block0: BlockId = <BlockId raw=0U64 />,
        block1: BlockId = <BlockId raw=0U64 />,
        args: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        elems: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        keys: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        values: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        fields: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        arms: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        params: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />,
        typeArgs: SyntaxSlice = <SyntaxSlice start=0U64 count=0U64 />
    ) -> ExprId {
        val id: ExprId = <ExprId raw=self.exprs.count() />
        self.exprs.append(<SyntaxExpr kind=kind span=span text=text name=name nameSpan=nameSpan op=op intValue=intValue flag0=flag0 flag1=flag1 child0=child0 child1=child1 child2=child2 type0=type0 block0=block0 block1=block1 args=args elems=elems keys=keys values=values fields=fields arms=arms params=params typeArgs=typeArgs />)
        return id
    }

    // These helpers are parser-only construction operations.  A completed
    // SyntaxFile is passed to the compiler as a `val`; its public read surface
    // will expose IDs and node views, never a materialized value AST.
    inout fn pushTextSlice(items: Array[Span]) -> SyntaxSlice {
        val start: U64 = self.texts.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.texts.append(items[i])
            i += 1U64
        }
        return <SyntaxSlice start=start count=items.count() />
    }

    inout fn pushTypeIdSlice(items: Array[TypeId]) -> SyntaxSlice {
        val start: U64 = self.typeIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.typeIds.append(items[i])
            i += 1U64
        }
        return <SyntaxSlice start=start count=items.count() />
    }

    inout fn pushExprIdSlice(items: Array[ExprId]) -> SyntaxSlice {
        val start: U64 = self.exprIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.exprIds.append(items[i])
            i += 1U64
        }
        return <SyntaxSlice start=start count=items.count() />
    }

    inout fn pushStmtIdSlice(items: Array[StmtId]) -> SyntaxSlice {
        val start: U64 = self.stmtIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.stmtIds.append(items[i])
            i += 1U64
        }
        return <SyntaxSlice start=start count=items.count() />
    }

    inout fn pushPatternIdSlice(items: Array[PatternId]) -> SyntaxSlice {
        val start: U64 = self.patternIds.count()
        mut val i: U64 = 0U64
        while i < items.count() {
            self.patternIds.append(items[i])
            i += 1U64
